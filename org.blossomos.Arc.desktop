[Desktop Entry]
Type=Application
Name=Arc Software
Comment=Discover and install applications from Flathub and your package files
Comment[de]=Apps aus Flathub und lokalen Paketen entdecken und installieren
Exec=arc-frontend %F
Icon=org.blossomos.Arc
Terminal=false
Categories=System;PackageManager;
StartupNotify=true
MimeType=application/x-deb;application/x-rpm;application/vnd.archlinux.pkg;

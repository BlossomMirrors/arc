msgstr "Tìm kiếm ứng dụng..."

msgid "No packages found.\nSearch for an application to get started."
msgstr ""
"Không tìm thấy gói phần mềm nào.\n"
"Tìm kiếm một ứng dụng để bắt đầu."

msgid "Everything is up to date."
msgstr "Mọi ứng dụng đã được cập nhật."

msgid "No applications installed."
msgstr "Không có ứng dụng nào được cài đặt."

msgid "Discover Great Software"
msgstr "Khám phá những ứng dụng hay"

msgid "Install apps from Flathub and your system repositories"
msgstr "Cài đặt ứng dụng từ Flathub và các kho ứng dụng trên hệ thống"

msgid "Popular"
msgstr "Phổ biến"

msgid "Recently Added"
msgstr "Mới thêm vào"

msgid "Categories"
msgstr "Thể loại"

msgid "Downloads & Updates"
msgstr "Tải về & Cập nhật"

msgid "Checking..."
msgstr "Đang kiểm tra..."

msgid "Check for Updates"
msgstr "Kiểm tra cập nhật mới"


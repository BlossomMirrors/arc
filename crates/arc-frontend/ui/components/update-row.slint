import { Palette } from "std-widgets.slint";
import { PackageItem } from "../types.slint";

export component UpdateRow inherits Rectangle {
    in property <PackageItem> item;
    callback update-clicked(string);

    height: 64px;

    Rectangle {
        x: 20px;
        y: parent.height - 1px;
        width: parent.width - 40px;
        height: 1px;
        background: #80808018;
    }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 14px;

        Rectangle {
            width: 44px;
            height: 44px;
            border-radius: 8px;
            background: #80808012;
            border-width: 1px;
            border-color: #80808020;

            Image {
                source: root.item.icon;
                width: 34px;
                height: 34px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                image-fit: contain;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.item.name != "" ? root.item.name : root.item.id;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }

            Text {
                text: root.item.version;
                font-size: 11px;
                color: Palette.foreground.transparentize(0.45);
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;

            btn-rect := Rectangle {
                width: btn-label.preferred-width + 24px;
                height: 28px;
                border-radius: 6px;
                background: btn-ta.has-hover ? #3b82f6 : #2563eb;

                btn-ta := TouchArea {
                    clicked => { root.update-clicked(root.item.id); }
                }

                btn-label := Text {
                    text: "Update";
                    font-size: 12px;
                    font-weight: 600;
                    color: white;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
    }
}

import { Theme } from "../theme.slint";
import { PackageItem } from "../types.slint";
import { AppIcon } from "app-icon.slint";
import { ActionButton } from "action-button.slint";

export component UpdateRow inherits Rectangle {
    in property <PackageItem> item;
    in property <string> tr-update: "Update";
    callback update-clicked(string);

    height: 64px;

    Rectangle {
        x: 20px;
        y: parent.height - 1px;
        width: parent.width - 40px;
        height: 1px;
        background: Theme.surface;
    }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 14px;

        AppIcon {
            size: 44px;
            icon: root.item.icon;
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.item.name != "" ? root.item.name : root.item.id;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }

            Text {
                text: root.item.version;
                font-size: 11px;
                color: Theme.fg-dim;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;

            ActionButton {
                height: 28px;
                border-radius: 6px;
                font-size: 12px;
                text: root.tr-update;
                clicked => {
                    root.update-clicked(root.item.id);
                }
            }
        }
    }
}

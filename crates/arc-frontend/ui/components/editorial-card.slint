import { Theme } from "../theme.slint";
import { HeroItem } from "../types.slint";

export component EditorialCard inherits Rectangle {
    in property <HeroItem> item;
    callback clicked(string, bool);  // (id, is-story)

    width: 220px;
    height: 150px;
    border-radius: 14px;
    clip: true;
    background: Theme.alternate-bg;

    if root.item.is-story && root.item.banner.width > 0: Image {
        source: root.item.banner;
        width: parent.width;
        height: parent.height;
        image-fit: cover;
    }

    if !root.item.is-story || root.item.banner.width == 0: Rectangle {
        width: parent.width;
        height: parent.height;
        background: @linear-gradient(135deg, Theme.card-deep-1 0%, Theme.card-deep-2 100%);
    }

    if !root.item.is-story && root.item.icon.width > 0: Rectangle {
        x: (parent.width - 56px) / 2;
        y: 20px;
        width: 56px;
        height: 56px;
        border-radius: 13px;
        clip: true;
        Image {
            source: root.item.icon;
            width: parent.width;
            height: parent.height;
            image-fit: contain;
        }
    }

    Rectangle {
        x: 0;
        y: parent.height - 80px;
        width: parent.width;
        height: 80px;
        background: @linear-gradient(180deg, transparent 0%, Colors.black.transparentize(0.18) 100%);
    }

    VerticalLayout {
        x: 12px;
        y: parent.height - 58px;
        width: parent.width - 24px;
        spacing: 3px;

        Text {
            text: root.item.title;
            font-size: 13px;
            font-weight: 700;
            color: Theme.on-image;
            overflow: elide;
        }

        if root.item.body != "": Text {
            text: root.item.body;
            font-size: 11px;
            color: Theme.on-image.transparentize(0.33);
            overflow: elide;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(root.item.id, root.item.is-story); }
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: parent.border-radius;
        border-width: ta.has-hover ? 2px : 1px;
        border-color: ta.has-hover ? Theme.on-image.transparentize(0.69) : Theme.on-image.transparentize(0.91);
        background: transparent;
        animate border-width { duration: 100ms; }
        animate border-color { duration: 100ms; }
    }
}

import { Palette } from "std-widgets.slint";
import { HeroItem } from "../types.slint";

export component EditorialCard inherits Rectangle {
    in property <HeroItem> item;
    callback clicked(string, bool);  // (id, is-story)

    width: 220px;
    height: 150px;
    border-radius: 14px;
    clip: true;
    background: Palette.alternate-background;

    // Story: full-coverage banner
    if root.item.is-story && root.item.banner.width > 0: Image {
        source: root.item.banner;
        width: parent.width;
        height: parent.height;
        image-fit: cover;
    }

    // App / no-banner: dark gradient
    if !root.item.is-story || root.item.banner.width == 0: Rectangle {
        width: parent.width;
        height: parent.height;
        background: @linear-gradient(135deg, #1e2440 0%, #0d0f1e 100%);
    }

    // App: icon in upper center
    if !root.item.is-story && root.item.icon.width > 0: Rectangle {
        x: (parent.width - 56px) / 2;
        y: 20px;
        width: 56px;
        height: 56px;
        border-radius: 13px;
        clip: true;
        Image {
            source: root.item.icon;
            width: parent.width;
            height: parent.height;
            image-fit: contain;
        }
    }

    // Bottom gradient
    Rectangle {
        x: 0;
        y: parent.height - 80px;
        width: parent.width;
        height: 80px;
        background: @linear-gradient(180deg, transparent 0%, #000000d0 100%);
    }

    // Title + subtitle
    VerticalLayout {
        x: 12px;
        y: parent.height - 58px;
        width: parent.width - 24px;
        spacing: 3px;

        Text {
            text: root.item.title;
            font-size: 13px;
            font-weight: 700;
            color: white;
            overflow: elide;
        }

        if root.item.body != "": Text {
            text: root.item.body;
            font-size: 11px;
            color: #ffffffaa;
            overflow: elide;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(root.item.id, root.item.is-story); }
    }

    // Hover border
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: parent.border-radius;
        border-width: ta.has-hover ? 2px : 1px;
        border-color: ta.has-hover ? #ffffff50 : #ffffff18;
        background: transparent;
        animate border-width { duration: 100ms; }
        animate border-color { duration: 100ms; }
    }
}

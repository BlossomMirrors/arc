import { Theme } from "../theme.slint";

export component SecurityWarning inherits Rectangle {
    in property <string> text;

    width: 320px;
    border-radius: 10px;
    background: Theme.warning-surface;
    border-width: 1px;
    border-color: Theme.warning-border;

    HorizontalLayout {
        padding: 12px;
        spacing: 10px;

        Image {
            source: @image-url("../../assets/warning.svg");
            width: 16px;
            height: 16px;
            colorize: Theme.warning;
            image-fit: contain;
            vertical-alignment: top;
        }

        Text {
            text: root.text;
            font-size: 11px;
            color: Theme.warning;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

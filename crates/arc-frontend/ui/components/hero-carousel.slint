import { Theme } from "../theme.slint";
import { ScrollArrow } from "scroll-arrow.slint";
import { HeroItem } from "../types.slint";

export component HeroCarousel inherits Rectangle {
    in property <[HeroItem]> items;
    in property <string> tr-installed: "Installed";

    callback story-clicked(int);
    callback app-clicked(string);

    private property <int> current-index: 0;

    height: 400px;
    clip: true;
    border-radius: 16px;
    background: Theme.alternate-bg;

    // Lowest z-order: provides has-hover to pause auto-advance
    hover-bg := TouchArea {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
    }

    Timer {
        interval: 5s;
        running: root.items.length > 1 && !hover-bg.has-hover;
        triggered => {
            root.current-index = mod(root.current-index + 1, root.items.length);
        }
    }

    for item[i] in root.items: Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        opacity: i == root.current-index ? 1.0 : 0.0;
        animate opacity { duration: 400ms; easing: ease-in-out; }

        if item.is-story && item.banner.width > 0: Image {
            source: item.banner;
            width: parent.width;
            height: parent.height;
            image-fit: cover;
        }

        if !item.is-story || item.banner.width == 0: Rectangle {
            width: parent.width;
            height: parent.height;
            background: @linear-gradient(135deg, Theme.card-deep-1 0%, Theme.card-deep-2 100%);
        }

        if !item.is-story && item.icon.width > 0: Rectangle {
            x: (parent.width - 120px) / 2;
            y: 60px;
            width: 120px;
            height: 120px;
            border-radius: 26px;
            clip: true;
            Image {
                source: item.icon;
                width: parent.width;
                height: parent.height;
                image-fit: contain;
            }
        }

        Rectangle {
            x: 0;
            y: parent.height - 180px;
            width: parent.width;
            height: 180px;
            background: @linear-gradient(180deg, transparent 0%, Colors.black.transparentize(0.12) 100%);
        }

        VerticalLayout {
            x: 24px;
            y: parent.height - 110px;
            width: parent.width - 120px;
            spacing: 6px;

            Text {
                text: item.title;
                font-size: item.is-story ? 28px : 22px;
                font-weight: 700;
                color: Theme.on-image;
                wrap: word-wrap;
                overflow: elide;
            }

            if item.body != "": Text {
                text: item.body;
                font-size: 13px;
                color: Theme.on-image.transparentize(0.2);
                overflow: elide;
                max-height: 40px;
            }
        }

        ta := TouchArea {
            enabled: i == root.current-index;
            mouse-cursor: pointer;
            clicked => {
                if item.is-story {
                    root.story-clicked(item.story-index);
                } else {
                    root.app-clicked(item.id);
                }
            }
        }
    }

    if root.items.length > 1: ScrollArrow {
        x: 16px;
        y: (parent.height - self.height) / 2;
        points-left: true;
        active: root.current-index > 0;
        activated => {
            root.current-index -= 1;
        }
    }

    if root.items.length > 1: ScrollArrow {
        x: parent.width - self.width - 16px;
        y: (parent.height - self.height) / 2;
        points-left: false;
        active: root.current-index < root.items.length - 1;
        activated => {
            root.current-index += 1;
        }
    }

    if root.items.length > 1: HorizontalLayout {
        y: parent.height - 20px;
        width: parent.width;
        alignment: center;
        spacing: 6px;

        for item[i] in root.items: Rectangle {
            width: i == root.current-index ? 20px : 6px;
            height: 6px;
            border-radius: 3px;
            background: i == root.current-index ? Theme.on-image : Theme.on-image.transparentize(0.67);
            animate width { duration: 200ms; easing: ease-in-out; }
        }
    }
}

import { Palette } from "std-widgets.slint";
import { HeroItem } from "../types.slint";

export component HeroCarousel inherits Rectangle {
    in property <[HeroItem]> items;
    in property <string> tr-installed: "Installed";

    callback story-clicked(int);
    callback app-clicked(string);

    private property <int> current-index: 0;

    height: 400px;
    clip: true;
    border-radius: 16px;
    background: Palette.alternate-background;

    // Lowest z-order: provides has-hover to pause auto-advance
    hover-bg := TouchArea {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
    }

    Timer {
        interval: 5s;
        running: root.items.length > 1 && !hover-bg.has-hover;
        triggered => {
            root.current-index = mod(root.current-index + 1, root.items.length);
        }
    }

    for item[i] in root.items: Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        opacity: i == root.current-index ? 1.0 : 0.0;
        animate opacity { duration: 400ms; easing: ease-in-out; }

        // Story: full-coverage banner
        if item.is-story && item.banner.width > 0: Image {
            source: item.banner;
            width: parent.width;
            height: parent.height;
            image-fit: cover;
        }

        // App / no-banner fallback
        if !item.is-story || item.banner.width == 0: Rectangle {
            width: parent.width;
            height: parent.height;
            background: @linear-gradient(135deg, #1a1f3c 0%, #0c0f1e 100%);
        }

        // App: icon centered upper portion
        if !item.is-story && item.icon.width > 0: Rectangle {
            x: (parent.width - 120px) / 2;
            y: 60px;
            width: 120px;
            height: 120px;
            border-radius: 26px;
            clip: true;
            Image {
                source: item.icon;
                width: parent.width;
                height: parent.height;
                image-fit: contain;
            }
        }

        // Deep gradient overlay for text readability
        Rectangle {
            x: 0;
            y: parent.height - 180px;
            width: parent.width;
            height: 180px;
            background: @linear-gradient(180deg, transparent 0%, #000000e0 100%);
        }

        // Title + body
        VerticalLayout {
            x: 24px;
            y: parent.height - 110px;
            width: parent.width - 120px;
            spacing: 6px;

            Text {
                text: item.title;
                font-size: item.is-story ? 28px : 22px;
                font-weight: 700;
                color: white;
                wrap: word-wrap;
                overflow: elide;
            }

            if item.body != "": Text {
                text: item.body;
                font-size: 13px;
                color: #ffffffcc;
                overflow: elide;
                max-height: 40px;
            }
        }

        ta := TouchArea {
            enabled: i == root.current-index;
            mouse-cursor: pointer;
            clicked => {
                if item.is-story {
                    root.story-clicked(item.story-index);
                } else {
                    root.app-clicked(item.id);
                }
            }
        }
    }

    // Left arrow — circular button
    if root.items.length > 1: Rectangle {
        x: 16px;
        y: (parent.height - 40px) / 2;
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background: #000000bb;
        opacity: root.current-index > 0 ? 1.0 : 0.0;
        animate opacity { duration: 150ms; }

        TouchArea {
            enabled: root.current-index > 0;
            mouse-cursor: pointer;
            clicked => { root.current-index -= 1; }
        }

        Image {
            source: @image-url("../../assets/chevron-left.svg");
            width: 14px; height: 14px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            image-fit: contain;
            colorize: white;
        }
    }

    // Right arrow — circular button
    if root.items.length > 1: Rectangle {
        x: parent.width - 56px;
        y: (parent.height - 40px) / 2;
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background: #000000bb;
        opacity: root.current-index < root.items.length - 1 ? 1.0 : 0.0;
        animate opacity { duration: 150ms; }

        TouchArea {
            enabled: root.current-index < root.items.length - 1;
            mouse-cursor: pointer;
            clicked => { root.current-index += 1; }
        }

        Image {
            source: @image-url("../../assets/chevron-right.svg");
            width: 14px; height: 14px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            image-fit: contain;
            colorize: white;
        }
    }

    // Page dots
    if root.items.length > 1: HorizontalLayout {
        y: parent.height - 20px;
        width: parent.width;
        alignment: center;
        spacing: 6px;

        for item[i] in root.items: Rectangle {
            width: i == root.current-index ? 20px : 6px;
            height: 6px;
            border-radius: 3px;
            background: i == root.current-index ? white : #ffffff55;
            animate width { duration: 200ms; easing: ease-in-out; }
        }
    }
}

import { Theme } from "../theme.slint";
import { AppCardData } from "../types.slint";
import { Badge } from "badge.slint";

export component AppCard inherits Rectangle {
    in property <AppCardData> card;
    in property <bool> is-small: false;
    in property <string> tr-installed: "Installed";
    callback clicked(string);

    border-radius: root.is-small ? 12px : 14px;
    background: Theme.alternate-bg;
    border-width: 1px;
    border-color: ta.has-hover
        ? Theme.fg.transparentize(0.72)
        : Theme.fg.transparentize(0.91);
    animate border-color { duration: 120ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(root.card.id); }
    }

    VerticalLayout {
        alignment: center;
        padding: root.is-small ? 10px : 14px;
        spacing: root.is-small ? 6px : 8px;

        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: root.is-small ? 48px : 76px;
                height: root.is-small ? 48px : 76px;
                border-radius: root.is-small ? 11px : 17px;
                clip: true;
                background: Theme.surface;

                Image {
                    source: root.card.icon;
                    width: parent.width;
                    height: parent.height;
                    image-fit: contain;
                }
            }
        }

        Text {
            text: root.card.name;
            font-weight: 600;
            font-size: 12px;
            overflow: elide;
            horizontal-alignment: center;
        }

        if !root.is-small: Text {
            text: root.card.summary;
            font-size: 10px;
            color: Theme.fg.transparentize(0.5);
            overflow: elide;
            horizontal-alignment: center;
        }

        if root.card.installed: HorizontalLayout {
            alignment: center;
            Badge {
                has-icon: true;
                icon: @image-url("../../assets/check.svg");
                label: root.tr-installed;
            }
        }
    }
}

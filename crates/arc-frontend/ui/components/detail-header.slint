import { Button } from "std-widgets.slint";
import { Palette } from "std-widgets.slint";
import { AppDetailData } from "../types.slint";
import { Badge } from "badge.slint";

export component DetailHeader inherits Rectangle {
    in property <AppDetailData> detail-app;
    in property <bool> detail-busy;
    in property <float> detail-progress;
    in property <string> detail-transaction-id;
    in property <string> settings-preferred;
    in property <bool> has-extensions: false;
    in property <image> icon-trash;
    in property <string> tr-back: "Back";
    in property <string> tr-install: "Install";
    in property <string> tr-run: "Run";
    in property <string> tr-cancel: "Cancel";
    in property <string> tr-working: "Working...";
    in property <string> tr-verified: "Verified developer";
    in property <string> tr-proprietary: "Proprietary";
    in property <string> tr-all-ages: "All ages";
    in property <string> tr-pwa: "PWA";

    callback back-clicked();
    callback install-requested(string);
    callback remove-requested(string);
    callback cancel-requested(string);
    callback launch-requested(string);
    callback extensions-clicked();
    callback eula-requested();

    private property <length> shared-btn-width: 90px;
    private property <length> shared-btn-height: 36px;
    private property <bool> btn-is-appimage: root.detail-app.appimage-id != "";
    private property <bool> btn-is-lutris: !root.btn-is-appimage && root.detail-app.lutris-id != "" && (root.settings-preferred == "Lutris" || (root.detail-app.flatpak-id == "" && root.detail-app.native-id == ""));
    private property <bool> btn-is-native: !root.btn-is-appimage && root.detail-app.native-id != "" && (root.settings-preferred == "Native" || (root.detail-app.flatpak-id == "" && root.detail-app.lutris-id == ""));
    private property <bool> btn-is-installed: root.btn-is-appimage ? root.detail-app.appimage-installed : (root.btn-is-lutris ? root.detail-app.lutris-installed : (root.btn-is-native ? root.detail-app.native-installed : root.detail-app.flatpak-installed));
    private property <string> btn-active-id: root.btn-is-appimage ? root.detail-app.appimage-id : (root.btn-is-lutris ? root.detail-app.lutris-id : (root.btn-is-native ? root.detail-app.native-id : root.detail-app.flatpak-id));

    VerticalLayout {
        spacing: 0px;

        // Back button row
        HorizontalLayout {
            padding-left: 30px;
            padding-right: 30px;
            padding-top: 20px;
            padding-bottom: 12px;
            alignment: start;

            Rectangle {
                width: back-row.preferred-width + 12px;
                height: 28px;
                border-radius: 6px;
                background: back-ta.has-hover ? #80808018 : #00000000;
                border-width: 1px;
                border-color: back-ta.has-hover ? #80808035 : #80808025;

                back-ta := TouchArea {
                    clicked => {
                        root.back-clicked();
                    }
                }

                back-row := HorizontalLayout {
                    x: 0;
                    y: 0;
                    padding-left: 6px;
                    padding-right: 8px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    spacing: 4px;
                    alignment: center;

                    Text {
                        text: "←";
                        font-size: 13px;
                        vertical-alignment: center;
                        color: Palette.foreground.transparentize(0.2);
                    }

                    Text {
                        text: root.tr-back;
                        font-size: 13px;
                        vertical-alignment: center;
                        color: Palette.foreground.transparentize(0.2);
                    }
                }
            }
        }

        // App info row: icon | name/developer/badges (stretch) | install button
        HorizontalLayout {
            padding-left: 30px;
            padding-right: 30px;
            padding-bottom: 20px;
            spacing: 20px;

            // App icon
            Rectangle {
                width: 96px;
                height: 96px;
                border-radius: 16px;
                background: #80808012;
                border-width: 1px;
                border-color: #80808025;

                Image {
                    source: root.detail-app.icon;
                    width: 80px;
                    height: 80px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    image-fit: contain;
                }
            }

            // Name / developer / metadata chips
            VerticalLayout {
                alignment: center;
                spacing: 6px;
                horizontal-stretch: 1;

                Text {
                    text: root.detail-app.name;
                    font-size: 22px;
                    font-weight: 700;
                    overflow: elide;
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    Text {
                        text: root.detail-app.developer;
                        font-size: 13px;
                        color: Palette.foreground.transparentize(0.35);
                        vertical-alignment: center;
                    }

                    if root.detail-app.verified: Rectangle {
                        width: 14px;
                        height: 14px;

                        Image {
                            source: @image-url("../../assets/verified.svg");
                            width: 14px;
                            height: 14px;
                            colorize: #0d6efd;
                        }

                        verified-ta := TouchArea {}

                        if verified-ta.has-hover: Rectangle {
                            x: 0px;
                            y: 20px;
                            width: tt-text.preferred-width + 12px;
                            height: 22px;
                            background: Palette.color-scheme == ColorScheme.dark ? #e2e8f0 : #1e293b;
                            border-radius: 4px;

                            tt-text := Text {
                                x: 6px;
                                y: (parent.height - self.preferred-height) / 2;
                                text: root.tr-verified;
                                font-size: 11px;
                                color: Palette.color-scheme == ColorScheme.dark ? #1e293b : #f1f5f9;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    padding-top: 4px;

                    if root.detail-app.version != "": Badge {
                        label: root.detail-app.version;
                        accent: Palette.foreground.transparentize(0.3);
                    }

                    if root.detail-app.license != "": Badge {
                        label: root.detail-app.license == "Proprietary"
                            ? root.tr-proprietary
                            : root.detail-app.license;
                        accent: root.detail-app.license == "Proprietary" ? #ef4444 : #3b82f6;
                    }

                    if root.detail-app.content-rating != "": Badge {
                        label: root.detail-app.content-rating == "All ages"
                            ? root.tr-all-ages
                            : root.detail-app.content-rating;
                        accent: root.detail-app.content-rating == "18+" ? #ef4444 : root.detail-app.content-rating == "12+" ? #f97316 : root.detail-app.content-rating == "7+" ? #eab308 : Palette.foreground.transparentize(0.4);
                    }

                    if root.detail-app.pwa: Badge {
                        label: root.tr-pwa;
                        accent: #8b5cf6;
                    }
                }
            }

            // Buttons column
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;

                if !root.detail-busy: HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    if root.has-extensions && root.btn-is-installed: Rectangle {
                        width: root.shared-btn-height;
                        height: root.shared-btn-height;
                        border-radius: 8px;
                        background: ext-icon-ta.has-hover ? #80808020 : #80808010;
                        border-width: 1px;
                        border-color: #80808030;

                        ext-icon-ta := TouchArea {
                            clicked => {
                                root.extensions-clicked();
                            }
                        }

                        Text {
                            text: "⊞";
                            font-size: 17px;
                            color: Palette.foreground.transparentize(0.2);
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    if root.btn-is-installed: Rectangle {
                        width: root.shared-btn-height;
                        height: root.shared-btn-height;
                        border-radius: 8px;
                        background: root.btn-active-id == "" ? #80808030 :
                            (remove-ta.has-hover ? #dc2626 : #ef4444);
                        border-width: root.btn-active-id == "" ? 1px : 0px;
                        border-color: #80808040;

                        remove-ta := TouchArea {
                            enabled: root.btn-active-id != "";
                            clicked => {
                                root.remove-requested(root.btn-active-id);
                            }
                        }

                        Image {
                            source: root.icon-trash;
                            width: 14px;
                            height: 14px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: root.btn-active-id == "" ? Palette.foreground.transparentize(0.6) : white;
                        }
                    }

                    if !root.btn-is-appimage && !root.btn-is-installed: Rectangle {
                        width: root.shared-btn-width;
                        height: root.shared-btn-height;
                        border-radius: 8px;
                        background: root.btn-active-id == "" ? #80808030 :
                            (install-ta.has-hover ? #80808035 : #80808020);
                        border-width: 1px;
                        border-color: #80808040;

                        install-ta := TouchArea {
                            enabled: root.btn-active-id != "";
                            clicked => {
                                if root.detail-app.eula-url != "" {
                                    root.eula-requested();
                                } else {
                                    root.install-requested(root.btn-active-id);
                                }
                            }
                        }

                        Text {
                            text: root.tr-install;
                            font-size: 13px;
                            font-weight: 600;
                            color: root.btn-active-id == "" ?
                                Palette.foreground.transparentize(0.6) :
                                Palette.foreground.transparentize(0.05);
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    if root.btn-is-installed: Rectangle {
                        width: root.shared-btn-width;
                        height: root.shared-btn-height;
                        border-radius: 8px;
                        background: run-ta.has-hover ? #2563eb : #3b82f6;

                        run-ta := TouchArea {
                            clicked => {
                                root.launch-requested(root.btn-active-id);
                            }
                        }

                        run-label := Text {
                            text: root.tr-run;
                            font-size: 13px;
                            font-weight: 600;
                            color: white;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                if root.detail-busy && (root.detail-app.flatpak-id != "" || root.detail-app.appimage-id != ""): Rectangle {
                    width: cancel-detail-label.preferred-width + 24px;
                    height: root.shared-btn-height;
                    border-radius: 8px;
                    background: cancel-detail-ta.has-hover ? #dc2626 : #ef4444;

                    cancel-detail-ta := TouchArea {
                        clicked => {
                            root.cancel-requested(root.detail-transaction-id);
                        }
                    }

                    cancel-detail-label := Text {
                        text: root.tr-cancel;
                        font-size: 13px;
                        font-weight: 600;
                        color: white;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                if root.detail-busy && root.detail-app.flatpak-id == "" && root.detail-app.appimage-id == "": Text {
                    text: root.tr-working;
                    font-size: 13px;
                    color: Palette.foreground.transparentize(0.4);
                    vertical-alignment: center;
                }
            }
        }

        // Progress bar below the app-info row when busy
        if root.detail-busy: HorizontalLayout {
            padding-left: 30px;
            padding-right: 30px;
            padding-bottom: 12px;

            Rectangle {
                height: 4px;
                border-radius: 2px;
                background: #80808028;

                Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width * root.detail-progress;
                    height: parent.height;
                    border-radius: 2px;
                    background: #3b82f6;
                    animate width {
                        duration: 600ms;
                        easing: ease-in-out;
                    }
                }
            }
        }

        // Divider
        Rectangle {
            height: 1px;
            background: #80808025;
        }
    }
}

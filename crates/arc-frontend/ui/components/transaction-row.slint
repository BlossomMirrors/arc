import { Palette } from "std-widgets.slint";
import { TransactionItem } from "../types.slint";

export component TransactionRow inherits Rectangle {
    in property <TransactionItem> item;
    private property <int> pct: root.item.progress * 100;

    height: 68px;

    Rectangle {
        x: 20px;
        y: parent.height - 1px;
        width: parent.width - 40px;
        height: 1px;
        background: #80808018;
    }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 14px;

        Rectangle {
            width: 48px;
            height: 48px;
            border-radius: 8px;
            background: #80808012;
            border-width: 1px;
            border-color: #80808020;

            Image {
                source: root.item.icon;
                width: 36px;
                height: 36px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                image-fit: contain;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 6px;
            horizontal-stretch: 1;

            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: root.item.name;
                    font-size: 13px;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Text {
                    text: root.item.tx-type == "install" || root.item.tx-type == "flatpakref" ? "Installing"
                        : root.item.tx-type == "remove" ? "Removing"
                        : "Updating";
                    font-size: 10px;
                    color: Palette.foreground.transparentize(0.5);
                    vertical-alignment: center;
                }
            }

            if root.item.status == "running" || root.item.status == "pending": Rectangle {
                height: 4px;
                border-radius: 2px;
                background: #80808020;
                clip: true;

                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: root.item.status == "pending" ? 0px
                        : parent.width * root.item.progress;
                    height: parent.height;
                    border-radius: 2px;
                    background: #3b82f6;
                    animate width { duration: 300ms; easing: ease-out; }
                }
            }

            if root.item.status == "failed": Text {
                text: root.item.error;
                font-size: 11px;
                color: #ef4444;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            min-width: 64px;

            Text {
                text: root.item.status == "running" ? root.pct + "%"
                    : root.item.status == "pending" ? "Queued"
                    : root.item.status == "completed" ? "Done"
                    : root.item.status == "failed" ? "Failed"
                    : "";
                font-size: 12px;
                font-weight: root.item.status == "running" ? 600 : 400;
                color: root.item.status == "completed" ? #22c55e
                    : root.item.status == "failed" ? #ef4444
                    : root.item.status == "running" ? #3b82f6
                    : Palette.foreground.transparentize(0.4);
                horizontal-alignment: right;
            }
        }
    }
}

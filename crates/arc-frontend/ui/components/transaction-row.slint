import { Palette, HorizontalBox } from "std-widgets.slint";
import { TransactionItem } from "../types.slint";
import { AppIcon } from "app-icon.slint";

export component TransactionRow inherits Rectangle {
    in property <TransactionItem> item;
    in property <string> tr-removed: "Removed";
    in property <string> tr-installed: "Installed";
    in property <string> tr-failed: "Failed";
    in property <string> tr-queued: "Queued";
    in property <string> tr-removing: "Removing";
    in property <string> tr-updating: "Updating";
    in property <string> tr-installing: "Installing";
    in property <string> tr-cancel: "Cancel";
    private property <int> pct: root.item.progress * 100;

    callback cancel-clicked(string);
    callback detail-requested(string);

    height: 76px;

    card := Rectangle {
        x: 20px;
        y: 6px;
        width: parent.width - 40px;
        height: parent.height - 12px;
        border-radius: 12px;
        background: card-ta.has-hover ? #80808030 : #80808020;
        border-width: 1px;
        border-color: #80808030;
        clip: true;

        card-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.detail-requested(root.item.parent-id != "" ? root.item.parent-id : root.item.pkg-id);
            }
        }

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 14px;
            padding-bottom: 15px;
            spacing: 12px;

            // Icon, pinned to center of the full card height (ignores asymmetric padding)
            AppIcon {
                size: 36px;
                icon: root.item.icon;
                y: (parent.height - self.height) / 2;
            }

            Text {
                text: root.item.name;
                font-size: 13px;
                font-weight: 700;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 5px;
                alignment: center;

                Text {
                    text: root.item.status == "completed" ? (root.item.tx-type == "remove" ? root.tr-removed : root.tr-installed) : root.item.status == "failed" ? root.tr-failed : root.item.status == "pending" ? root.tr-queued : root.item.tx-type == "remove" ? root.tr-removing : root.item.tx-type == "update" ? root.tr-updating : root.tr-installing;
                    font-size: 12px;
                    color: root.item.status == "failed" ? #ef4444 : Palette.foreground.transparentize(0.45);
                    vertical-alignment: center;
                }

                Text {
                    text: root.pct + "%";
                    font-size: 13px;
                    font-weight: 700;
                    color: root.item.status == "failed" ? #ef4444 : root.item.status == "completed" ? (Palette.color-scheme == ColorScheme.dark ? #22c55e : #15803d) : Palette.foreground;
                    vertical-alignment: center;
                }
            }

            if root.item.status == "running" || root.item.status == "pending": VerticalLayout {
                alignment: center;
                padding-bottom: 4px;

                Rectangle {
                    width: cancel-label.preferred-width + 20px;
                    height: 30px;
                    border-radius: 8px;
                    background: cancel-ta.has-hover ? #dc2626 : #ef4444;

                    cancel-ta := TouchArea {
                        clicked => {
                            root.cancel-clicked(root.item.id);
                        }
                    }

                    cancel-label := Text {
                        text: root.tr-cancel;
                        font-size: 12px;
                        font-weight: 600;
                        color: white;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
        }

        Rectangle {
            x: 66px;
            y: parent.height - 15px;
            width: parent.width - 66px - 18px;
            height: 5px;
            border-radius: 3px;
            background: #80808028;

            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width * root.item.progress;
                height: parent.height;
                border-radius: 3px;
                background: #3b82f6;
                animate width {
                    duration: 600ms;
                    easing: ease-in-out;
                }
            }
        }
    }
}

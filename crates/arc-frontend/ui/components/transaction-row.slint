import { Palette, HorizontalBox } from "std-widgets.slint";
import { TransactionItem } from "../types.slint";

export component TransactionRow inherits Rectangle {
    in property <TransactionItem> item;
    private property <int> pct: root.item.progress * 100;

    callback cancel-clicked(string);
    callback detail-requested(string);

    height: 76px;

    card := Rectangle {
        x: 20px;
        y: 6px;
        width: parent.width - 40px;
        height: parent.height - 12px;
        border-radius: 12px;
        background: card-ta.has-hover ? #80808030 : #80808020;
        border-width: 1px;
        border-color: #80808030;
        clip: true;

        card-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.detail-requested(root.item.parent-id != "" ? root.item.parent-id : root.item.pkg-id);
            }
        }

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 14px;
            padding-bottom: 15px;
            spacing: 12px;

            // Icon, pinned to center of the full card height (ignores asymmetric padding)
            Rectangle {
                width: 36px;
                height: 36px;
                y: (parent.height - self.height) / 2;
                border-radius: 8px;
                background: #80808018;
                border-width: 1px;
                border-color: #80808020;

                Image {
                    source: root.item.icon;
                    width: 26px;
                    height: 26px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    image-fit: contain;
                }
            }

            Text {
                text: root.item.name;
                font-size: 13px;
                font-weight: 700;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 5px;
                alignment: center;

                Text {
                    text: root.item.status == "completed" ? (root.item.tx-type == "remove" ? "Removed" : "Installed") : root.item.status == "failed" ? "Failed" : root.item.status == "pending" ? "Queued" : root.item.tx-type == "remove" ? "Removing" : root.item.tx-type == "update" ? "Updating" : "Installing";
                    font-size: 12px;
                    color: root.item.status == "failed" ? #ef4444 : Palette.foreground.transparentize(0.45);
                    vertical-alignment: center;
                }

                Text {
                    text: root.pct + "%";
                    font-size: 13px;
                    font-weight: 700;
                    color: root.item.status == "failed" ? #ef4444 : root.item.status == "completed" ? (Palette.color-scheme == ColorScheme.dark ? #22c55e : #15803d) : Palette.foreground;
                    vertical-alignment: center;
                }
            }

            if root.item.status == "running" || root.item.status == "pending": VerticalLayout {
                alignment: center;
                padding-bottom: 4px;

                Rectangle {
                    width: cancel-label.preferred-width + 20px;
                    height: 30px;
                    border-radius: 8px;
                    background: cancel-ta.has-hover ? #ff33b0 : #e91e90;

                    cancel-ta := TouchArea {
                        clicked => {
                            root.cancel-clicked(root.item.id);
                        }
                    }

                    cancel-label := Text {
                        text: "Cancel";
                        font-size: 12px;
                        font-weight: 600;
                        color: white;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
        }

        Rectangle {
            x: 66px;
            y: parent.height - 15px;
            width: parent.width - 66px - 18px;
            height: 5px;
            border-radius: 3px;
            background: #80808028;

            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width * root.item.progress;
                height: parent.height;
                border-radius: 3px;
                background: #3b82f6;
                animate width {
                    duration: 600ms;
                    easing: ease-in-out;
                }
            }
        }
    }
}

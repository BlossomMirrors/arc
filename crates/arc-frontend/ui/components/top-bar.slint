import { Button, LineEdit } from "std-widgets.slint";
import { Palette } from "std-widgets.slint";

export component TopBar inherits Rectangle {
    in-out property <string> search-text;
    in property <int> update-count;
    in property <image> icon-home;
    in property <image> icon-search;
    in property <image> icon-settings;

    callback search-requested(string);
    callback installed-clicked();
    callback downloads-clicked();
    callback home-clicked();
    callback settings-clicked();

    height: 52px;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 8px;
            padding-bottom: 7px;
            spacing: 8px;

            Rectangle {
                width: 34px;
                border-radius: 6px;
                background: home-ta.has-hover ? #80808018 : #00000000;

                home-ta := TouchArea {
                    clicked => {
                        root.home-clicked();
                    }
                }

                Image {
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.icon-home;
                    colorize: Palette.foreground;
                    image-fit: contain;
                }
            }

            Rectangle {
                width: 1px;
                background: #80808035;
            }

            LineEdit {
                horizontal-stretch: 1;
                placeholder-text: "Search for applications...";
                text <=> root.search-text;
                accepted(text) => {
                    if (text != "") {
                        root.search-requested(text);
                    }
                }
            }

            Rectangle {
                width: 34px;
                border-radius: 6px;
                background: search-ta.has-hover ? #80808018 : #00000000;

                search-ta := TouchArea {
                    clicked => {
                        if (root.search-text != "") {
                            root.search-requested(root.search-text);
                        }
                    }
                }

                Image {
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.icon-search;
                    colorize: Palette.foreground;
                    image-fit: contain;
                }
            }

            // Group separator
            Rectangle {
                width: 1px;
                background: #80808035;
            }

            Button {
                text: "Installed";
                clicked => {
                    root.installed-clicked();
                }
            }

            Rectangle {
                width: dl-row.preferred-width + 20px;
                border-radius: 6px;
                background: dl-ta.has-hover ? #80808018 : #00000000;
                border-width: 1px;
                border-color: #80808030;

                dl-ta := TouchArea {
                    clicked => {
                        root.downloads-clicked();
                    }
                }

                dl-row := HorizontalLayout {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    spacing: 5px;
                    alignment: center;

                    Text {
                        text: "Downloads & Updates";
                        font-size: 12px;
                        color: Palette.foreground;
                        vertical-alignment: center;
                    }

                    if root.update-count > 0: Rectangle {
                        width: max(bubble-n.preferred-width + 8px, 16px);
                        height: 16px;
                        border-radius: 8px;
                        background: #ef4444;
                        y: (parent.height - self.height) / 2;

                        bubble-n := Text {
                            text: root.update-count;
                            font-size: 9px;
                            font-weight: 700;
                            color: white;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }

            // Group separator
            Rectangle {
                width: 1px;
                background: #80808035;
            }

            Rectangle {
                width: 34px;
                border-radius: 6px;
                background: settings-ta.has-hover ? #80808018 : #00000000;

                settings-ta := TouchArea {
                    clicked => {
                        root.settings-clicked();
                    }
                }

                Image {
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.icon-settings;
                    colorize: Palette.foreground;
                    image-fit: contain;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: #80808025;
        }
    }
}

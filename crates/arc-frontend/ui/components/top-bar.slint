import { LineEdit } from "std-widgets.slint";
import { Palette } from "std-widgets.slint";

export component TopBar inherits Rectangle {
    in-out property <string> search-text;
    in property <int> update-count;
    in property <string> current-view;
    in property <image> icon-home;
    in property <image> icon-search;
    in property <image> icon-settings;

    callback search-requested(string);
    callback installed-clicked();
    callback downloads-clicked();
    callback home-clicked();
    callback settings-clicked();

    height: 52px;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 8px;
            padding-bottom: 7px;
            spacing: 8px;

            Rectangle {
                width: 34px;
                border-radius: 6px;
                background: home-ta.has-hover ? #80808018 : #00000000;

                home-ta := TouchArea {
                    clicked => { root.home-clicked(); }
                }

                Image {
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.icon-home;
                    colorize: Palette.foreground;
                    image-fit: contain;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                border-radius: 6px;
                border-width: 1.5px;
                border-color: search-input.has-focus ? Palette.selection-background : Palette.border;
                background: Palette.control-background;
                clip: true;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 4px;
                    spacing: 0px;

                    Rectangle {
                        horizontal-stretch: 1;
                        clip: true;

                        search-input := TextInput {
                            width: parent.width;
                            height: parent.height;
                            vertical-alignment: center;
                            font-size: 14px;
                            color: Palette.foreground;
                            text <=> root.search-text;
                            accepted => {
                                if (root.search-text != "") {
                                    root.search-requested(root.search-text);
                                }
                            }
                        }

                        if root.search-text == "": Text {
                            x: 0;
                            y: (parent.height - self.height) / 2;
                            text: "Search for applications...";
                            font-size: 14px;
                            color: Palette.foreground.transparentize(0.5);
                        }
                    }

                    Rectangle {
                        width: 32px;
                        border-radius: 4px;
                        background: search-icon-ta.has-hover ? #80808018 : #00000000;

                        search-icon-ta := TouchArea {
                            clicked => {
                                if (root.search-text != "") {
                                    root.search-requested(root.search-text);
                                }
                            }
                        }

                        Image {
                            width: 16px;
                            height: 16px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: root.icon-search;
                            colorize: Palette.foreground.transparentize(0.3);
                            image-fit: contain;
                        }
                    }
                }
            }

            // Button group
            Rectangle {
                width: group-layout.preferred-width + 4px;
                height: 36px;
                border-radius: 8px;
                border-width: 1px;
                border-color: #80808030;
                background: #80808010;
                clip: true;

                group-layout := HorizontalLayout {
                    padding: 2px;
                    spacing: 0px;

                    // Installed segment
                    Rectangle {
                        width: installed-label.preferred-width + 20px;
                        border-radius: 6px;
                        background: root.current-view == "installed"
                            ? #ffffff30
                            : (installed-ta.has-hover ? #80808020 : #00000000);

                        installed-ta := TouchArea {
                            clicked => { root.installed-clicked(); }
                        }

                        installed-label := Text {
                            text: "Installed";
                            font-size: 12px;
                            color: root.current-view == "installed"
                                ? Palette.foreground
                                : #808080;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Downloads & Updates segment
                    Rectangle {
                        width: dl-row.preferred-width + 20px;
                        border-radius: 6px;
                        background: root.current-view == "downloads"
                            ? #ffffff30
                            : (dl-ta.has-hover ? #80808020 : #00000000);

                        dl-ta := TouchArea {
                            clicked => { root.downloads-clicked(); }
                        }

                        dl-row := HorizontalLayout {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            spacing: 5px;
                            alignment: center;

                            Text {
                                text: "Downloads & Updates";
                                font-size: 12px;
                                    color: root.current-view == "downloads"
                                    ? Palette.foreground
                                    : #808080;
                                vertical-alignment: center;
                            }

                            if root.update-count > 0: Rectangle {
                                width: max(bubble-n.preferred-width + 8px, 16px);
                                height: 16px;
                                border-radius: 8px;
                                background: #ef4444;
                                y: (parent.height - self.height) / 2;

                                bubble-n := Text {
                                    text: root.update-count;
                                    font-size: 9px;
                                    font-weight: 700;
                                    color: white;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                width: 34px;
                border-radius: 6px;
                background: settings-ta.has-hover ? #80808018 : #00000000;

                settings-ta := TouchArea {
                    clicked => { root.settings-clicked(); }
                }

                Image {
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.icon-settings;
                    colorize: Palette.foreground;
                    image-fit: contain;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: #80808025;
        }
    }
}

import { LineEdit } from "std-widgets.slint";
import { Palette } from "std-widgets.slint";

export component TopBar inherits Rectangle {
    in-out property <string> search-text;
    in property <int> update-count;
    in property <string> current-view;
    in property <image> icon-home;
    in property <image> icon-search;
    in property <image> icon-settings;
    in property <image> icon-nav-back;
    in property <image> icon-nav-forward;
    in property <bool> can-go-back: false;
    in property <bool> can-go-forward: false;

    in property <string> tr-search-placeholder: "Search for applications...";
    in property <string> tr-installed: "Installed";
    in property <string> tr-downloads: "Downloads & Updates";

    callback search-requested(string);
    callback installed-clicked();
    callback downloads-clicked();
    callback home-clicked();
    callback settings-clicked();
    callback nav-back();
    callback nav-forward();

    public function clear-search-focus() {
        search-input.clear-focus();
    }

    height: 58px;

    // Full-area background touch zone — defocuses the search bar when the
    // user clicks anywhere in the top bar that isn't an interactive element.
    defocus-ta := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { search-input.clear-focus(); }
    }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 16px;
            padding-top: 8px;
            padding-bottom: 11px;
            spacing: 8px;

            // Back / forward navigation buttons
            Rectangle {
                width: 56px;
                border-radius: 6px;
                background: transparent;

                HorizontalLayout {
                    spacing: 0px;

                    Rectangle {
                        width: 28px;
                        border-radius: 6px;
                        background: back-nav-ta.has-hover && root.can-go-back ? #80808018 : #00000000;

                        back-nav-ta := TouchArea {
                            enabled: root.can-go-back;
                            mouse-cursor: root.can-go-back ? pointer : default;
                            clicked => { root.nav-back(); }
                        }

                        Image {
                            width: 14px;
                            height: 14px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: root.icon-nav-back;
                            colorize: root.can-go-back ? Palette.foreground : Palette.foreground.transparentize(0.65);
                            image-fit: contain;
                        }
                    }

                    Rectangle {
                        width: 28px;
                        border-radius: 6px;
                        background: fwd-nav-ta.has-hover && root.can-go-forward ? #80808018 : #00000000;

                        fwd-nav-ta := TouchArea {
                            enabled: root.can-go-forward;
                            mouse-cursor: root.can-go-forward ? pointer : default;
                            clicked => { root.nav-forward(); }
                        }

                        Image {
                            width: 14px;
                            height: 14px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: root.icon-nav-forward;
                            colorize: root.can-go-forward ? Palette.foreground : Palette.foreground.transparentize(0.65);
                            image-fit: contain;
                        }
                    }
                }
            }

            Rectangle {
                width: 34px;
                border-radius: 6px;
                background: home-ta.has-hover ? #80808018 : #00000000;

                home-ta := TouchArea {
                    clicked => {
                        search-input.clear-focus();
                        root.home-clicked();
                    }
                }

                Image {
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.icon-home;
                    colorize: Palette.foreground;
                    image-fit: contain;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                border-radius: 6px;
                border-width: 1.5px;
                border-color: search-input.has-focus ? Palette.selection-background : Palette.border;
                background: Palette.control-background;
                clip: true;

                HorizontalLayout {
                    padding: 0px;
                    spacing: 0px;

                    // Search icon on the left — submits the query when clicked
                    Rectangle {
                        width: 34px;
                        border-radius: 4px;
                        background: search-icon-ta.has-hover ? #80808018 : #00000000;

                        search-icon-ta := TouchArea {
                            clicked => {
                                if root.search-text != "" {
                                    search-input.clear-focus();
                                    root.search-requested(root.search-text);
                                } else {
                                    search-input.focus();
                                }
                            }
                        }

                        Image {
                            width: 15px;
                            height: 15px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: root.icon-search;
                            colorize: search-input.has-focus
                                ? Palette.selection-background
                                : Palette.foreground.transparentize(0.4);
                            image-fit: contain;
                        }
                    }

                    // Text input
                    Rectangle {
                        horizontal-stretch: 1;
                        clip: true;

                        search-input := TextInput {
                            width: parent.width;
                            height: parent.height;
                            vertical-alignment: center;
                            font-size: 14px;
                            color: Palette.foreground;
                            text <=> root.search-text;
                            accepted => {
                                if root.search-text != "" {
                                    search-input.clear-focus();
                                    root.search-requested(root.search-text);
                                }
                            }
                        }

                        if root.search-text == "": Text {
                            x: 0;
                            y: (parent.height - self.height) / 2;
                            text: root.tr-search-placeholder;
                            font-size: 14px;
                            color: Palette.foreground.transparentize(0.5);
                        }
                    }

                    // Clear button on the right — only visible when there is text
                    if root.search-text != "": Rectangle {
                        width: 32px;
                        border-radius: 4px;
                        background: clear-ta.has-hover ? #80808018 : #00000000;

                        clear-ta := TouchArea {
                            clicked => {
                                root.search-text = "";
                                search-input.focus();
                            }
                        }

                        Text {
                            text: "×";
                            font-size: 18px;
                            color: Palette.foreground.transparentize(0.35);
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }

            // Tabs with sliding indicator
            Rectangle {
                width: tabs-row.preferred-width;
                height: 36px;
                border-radius: 8px;
                background: #80808010;
                clip: true;

                // Sliding pill — animates when current-view changes
                Rectangle {
                    x: root.current-view == "downloads"
                        ? (2px + installed-tab.width)
                        : 2px;
                    y: 2px;
                    width: root.current-view == "downloads"
                        ? downloads-tab.width
                        : installed-tab.width;
                    height: parent.height - 4px;
                    border-radius: 6px;
                    background: (root.current-view == "installed" || root.current-view == "downloads")
                        ? #3584e440
                        : transparent;
                    animate x { duration: 200ms; easing: ease-in-out; }
                    animate width { duration: 200ms; easing: ease-in-out; }
                    animate background { duration: 150ms; }
                }

                tabs-row := HorizontalLayout {
                    padding: 2px;
                    spacing: 0px;

                    installed-tab := Rectangle {
                        width: installed-label.preferred-width + 24px;

                        installed-ta := TouchArea {
                            clicked => {
                                search-input.clear-focus();
                                root.installed-clicked();
                            }
                        }

                        installed-label := Text {
                            width: parent.width;
                            height: parent.height;
                            text: root.tr-installed;
                            font-size: 12px;
                            color: root.current-view == "installed"
                                ? #3584e4
                                : Palette.foreground.transparentize(0.45);
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            animate color { duration: 150ms; }
                        }
                    }

                    downloads-tab := Rectangle {
                        width: dl-content.preferred-width + 24px;

                        dl-ta := TouchArea {
                            clicked => {
                                search-input.clear-focus();
                                root.downloads-clicked();
                            }
                        }

                        dl-content := HorizontalLayout {
                            width: parent.width;
                            height: parent.height;
                            spacing: 5px;
                            alignment: center;

                            Text {
                                text: root.tr-downloads;
                                font-size: 12px;
                                color: root.current-view == "downloads"
                                    ? #3584e4
                                    : Palette.foreground.transparentize(0.45);
                                vertical-alignment: center;
                                animate color { duration: 150ms; }
                            }

                            if root.update-count > 0: Rectangle {
                                width: max(bubble-n.preferred-width + 8px, 16px);
                                height: 16px;
                                border-radius: 8px;
                                background: #ef4444;
                                y: (parent.height - self.height) / 2;

                                bubble-n := Text {
                                    text: root.update-count;
                                    font-size: 9px;
                                    font-weight: 700;
                                    color: white;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                width: 34px;
                border-radius: 6px;
                background: settings-ta.has-hover ? #80808018 : #00000000;

                settings-ta := TouchArea {
                    clicked => {
                        search-input.clear-focus();
                        root.settings-clicked();
                    }
                }

                Image {
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.icon-settings;
                    colorize: Palette.foreground;
                    image-fit: contain;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: #80808025;
        }
    }
}

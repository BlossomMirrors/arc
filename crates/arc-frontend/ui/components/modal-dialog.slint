import { Theme } from "../theme.slint";

export component ModalDialog inherits Rectangle {
    in property <length> panel-width: 380px;
    in property <length> panel-height: panel-layout.preferred-height;
    in property <length> panel-y: (root.height - panel.height) / 2;

    callback dismissed();

    background: Theme.scrim;

    TouchArea {
        clicked => {
            root.dismissed();
        }
    }

    panel := Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.panel-y;
        width: min(root.panel-width, parent.width - 48px);
        height: root.panel-height;
        border-radius: 12px;
        background: Theme.window-bg;
        drop-shadow-blur: 32px;
        drop-shadow-color: Theme.scrim;

        // Absorb clicks so they don't fall through to the backdrop.
        TouchArea { }

        panel-layout := VerticalLayout {
            padding: 20px;
            spacing: 16px;

            @children
        }
    }
}

import { Theme } from "../theme.slint";

// Non-slip relationship: 672px travel over 1.0 phase => 1080deg rotation (12 x 90deg).
component RollingBlock inherits Rectangle {
    in property <float> phase;
    in property <color> highlight-color;
    in property <color> dark-color;

    // 12 bob cycles per full pass; triangle wave: 0 at corners, -9px at balance point
    private property <float> bob-t: mod(root.phase * 12.0, 1.0);

    width: 56px;
    height: 56px;
    border-radius: 20px;
    clip: true;

    x: -110px + root.phase * 672px;
    y: 57px - 9px * (1.0 - 2.0 * abs(root.bob-t - 0.5));
    transform-rotation: root.phase * 1080deg;

    background: @linear-gradient(135deg, root.highlight-color 0%, root.dark-color 100%);
    drop-shadow-blur: 14px;
    drop-shadow-color: Theme.accent.transparentize(0.78);
    drop-shadow-offset-x: 0px;
    drop-shadow-offset-y: 4px;

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: @linear-gradient(135deg, Theme.on-image.transparentize(0.8) 0%, transparent 58%);
    }
}

export component ConveyorLoader inherits Rectangle {
    width: 560px;
    height: 170px;
    clip: true;

    private property <float> phase: 0.0;

    Timer {
        interval: 16ms;
        triggered => {
            root.phase = mod(root.phase + 0.0026667, 1.0);
        }
    }

    // Five blocks staggered by 1/5 of the cycle (0.2 phase each).
    // highlight = base lightened ~22%, dark = base darkened ~42%.
    RollingBlock {
        phase: root.phase;
        highlight-color: Theme.accent.brighter(0.35);
        dark-color: Theme.accent.mix(Colors.black, 0.42);
    }
    RollingBlock {
        phase: mod(root.phase + 0.2, 1.0);
        highlight-color: Theme.accent.brighter(0.25);
        dark-color: Theme.accent.mix(Colors.black, 0.5);
    }
    RollingBlock {
        phase: mod(root.phase + 0.4, 1.0);
        highlight-color: Theme.accent.brighter(0.15);
        dark-color: Theme.accent.mix(Colors.black, 0.58);
    }
    RollingBlock {
        phase: mod(root.phase + 0.6, 1.0);
        highlight-color: Theme.accent.brighter(0.05);
        dark-color: Theme.accent.mix(Colors.black, 0.66);
    }
    RollingBlock {
        phase: mod(root.phase + 0.8, 1.0);
        highlight-color: Theme.accent;
        dark-color: Theme.accent.mix(Colors.black, 0.72);
    }

    Rectangle {
        x: 0;
        y: 0;
        width: 120px;
        height: parent.height;
        background: @linear-gradient(90deg, Theme.window-bg 0%, transparent 100%);
    }
    Rectangle {
        x: parent.width - 120px;
        y: 0;
        width: 120px;
        height: parent.height;
        background: @linear-gradient(270deg, Theme.window-bg 0%, transparent 100%);
    }
}

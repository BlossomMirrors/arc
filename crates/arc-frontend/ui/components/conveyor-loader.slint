import { Palette } from "std-widgets.slint";

// Non-slip relationship: 672px travel over 1.0 phase => 1080deg rotation (12 x 90deg).
component RollingBlock inherits Rectangle {
    in property <float> phase;
    in property <color> highlight-color;
    in property <color> dark-color;

    // 12 bob cycles per full pass; triangle wave: 0 at corners, -9px at balance point
    private property <float> bob-t: mod(root.phase * 12.0, 1.0);

    width: 56px;
    height: 56px;
    border-radius: 20px;
    clip: true;

    x: -110px + root.phase * 672px;
    y: 57px - 9px * (1.0 - 2.0 * abs(root.bob-t - 0.5));
    transform-rotation: root.phase * 1080deg;

    // High-contrast diagonal gradient: light top-left -> dark bottom-right
    background: @linear-gradient(135deg, root.highlight-color 0%, root.dark-color 100%);
    drop-shadow-blur: 14px;
    drop-shadow-color: #000dff38;
    drop-shadow-offset-x: 0px;
    drop-shadow-offset-y: 4px;

    // Gloss sheen: simulates a convex surface catching directional light
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: @linear-gradient(135deg, #ffffff32 0%, #ffffff00 58%);
    }
}

export component ConveyorLoader inherits Rectangle {
    width: 560px;
    height: 170px;
    clip: true;

    private property <float> phase: 0.0;

    Timer {
        interval: 16ms;
        triggered => {
            root.phase = mod(root.phase + 0.0026667, 1.0);
        }
    }

    // Five blocks staggered by 1/5 of the cycle (0.2 phase each).
    // highlight = base lightened ~22%, dark = base darkened ~42%.
    RollingBlock {
        phase: root.phase;
        highlight-color: #6896ff;
        dark-color: #244694;
    }
    RollingBlock {
        phase: mod(root.phase + 0.2, 1.0);
        highlight-color: #5d80ff;
        dark-color: #1b3594;
    }
    RollingBlock {
        phase: mod(root.phase + 0.4, 1.0);
        highlight-color: #526aff;
        dark-color: #132594;
    }
    RollingBlock {
        phase: mod(root.phase + 0.6, 1.0);
        highlight-color: #4656ff;
        dark-color: #0a1694;
    }
    RollingBlock {
        phase: mod(root.phase + 0.8, 1.0);
        highlight-color: #3842ff;
        dark-color: #000894;
    }

    Rectangle {
        x: 0;
        y: 0;
        width: 120px;
        height: parent.height;
        background: @linear-gradient(90deg, Palette.background 0%, transparent 100%);
    }
    Rectangle {
        x: parent.width - 120px;
        y: 0;
        width: 120px;
        height: parent.height;
        background: @linear-gradient(270deg, Palette.background 0%, transparent 100%);
    }
}

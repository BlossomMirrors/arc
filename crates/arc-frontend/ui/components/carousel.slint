import { Palette } from "std-widgets.slint";
import { AppCard } from "app-card.slint";
import { AppCardData } from "../types.slint";

export component Carousel inherits Rectangle {
    in property <[AppCardData]> items;
    in property <string> tr-installed: "Installed";
    callback item-clicked(string);

    private property <length> card-w: 196px;
    private property <length> card-gap: 12px;

    height: 206px;
    clip: true;
    preferred-width: 0px;

    flickable := Flickable {
        width: parent.width;
        height: parent.height;
        viewport-width: root.items.length * (root.card-w + root.card-gap);
        viewport-height: parent.height;
        interactive: true;

        animate viewport-x { duration: 250ms; easing: ease-in-out; }

        for app[i] in root.items: AppCard {
            x: i * (root.card-w + root.card-gap);
            y: 0px;
            width: root.card-w;
            height: root.height;
            card: app;
            tr-installed: root.tr-installed;
            clicked(id) => { root.item-clicked(id); }
        }
    }

    // Left arrow
    Rectangle {
        x: 4px;
        y: (parent.height - 40px) / 2;
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background: Palette.alternate-background;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000033;
        opacity: flickable.viewport-x < 0px ? 1.0 : 0.0;
        animate opacity { duration: 150ms; }

        TouchArea {
            enabled: flickable.viewport-x < 0px;
            mouse-cursor: pointer;
            clicked => {
                flickable.viewport-x = min(0px, flickable.viewport-x + 3 * (root.card-w + root.card-gap));
            }
        }

        Image {
            source: @image-url("../../assets/chevron-left.svg");
            width: 14px; height: 14px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            image-fit: contain;
            colorize: Palette.foreground;
        }
    }

    // Right arrow
    Rectangle {
        x: parent.width - 44px;
        y: (parent.height - 40px) / 2;
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background: Palette.alternate-background;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000033;
        opacity: flickable.viewport-x > -(flickable.viewport-width - flickable.width) ? 1.0 : 0.0;
        animate opacity { duration: 150ms; }

        TouchArea {
            enabled: flickable.viewport-x > -(flickable.viewport-width - flickable.width);
            mouse-cursor: pointer;
            clicked => {
                flickable.viewport-x = max(-(flickable.viewport-width - flickable.width), flickable.viewport-x - 3 * (root.card-w + root.card-gap));
            }
        }

        Image {
            source: @image-url("../../assets/chevron-right.svg");
            width: 14px; height: 14px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            image-fit: contain;
            colorize: Palette.foreground;
        }
    }
}

import { AppCard } from "app-card.slint";
import { AppCardData } from "../types.slint";

export component Carousel inherits Rectangle {
    in property <[AppCardData]> items;
    callback item-clicked(string);

    height: 192px;
    clip: true;
    preferred-width: 0px;

    flickable := Flickable {
        width: parent.width;
        height: parent.height;
        viewport-width: root.items.length * 192px;
        viewport-height: parent.height;
        interactive: false;

        animate viewport-x { duration: 250ms; easing: ease-in-out; }

        for app[i] in root.items: AppCard {
            x: i * 192px;
            y: 0px;
            width: 180px;
            height: 192px;
            card: app;
            clicked(id) => { root.item-clicked(id); }
        }
    }

    // Left button
    Rectangle {
        x: 4px;
        y: (parent.height - 48px) / 2;
        width: 32px;
        height: 48px;
        border-radius: 8px;
        background: #000000bb;
        opacity: flickable.viewport-x < 0px ? 1.0 : 0.0;
        animate opacity { duration: 150ms; }

        TouchArea {
            enabled: flickable.viewport-x < 0px;
            clicked => {
                flickable.viewport-x = min(0px, flickable.viewport-x + 3 * 192px);
            }
        }

        Text {
            text: "‹";
            font-size: 24px;
            color: white;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Right button
    Rectangle {
        x: parent.width - 36px;
        y: (parent.height - 48px) / 2;
        width: 32px;
        height: 48px;
        border-radius: 8px;
        background: #000000bb;
        opacity: flickable.viewport-x > -(flickable.viewport-width - flickable.width) ? 1.0 : 0.0;
        animate opacity { duration: 150ms; }

        TouchArea {
            enabled: flickable.viewport-x > -(flickable.viewport-width - flickable.width);
            clicked => {
                flickable.viewport-x = max(-(flickable.viewport-width - flickable.width), flickable.viewport-x - 3 * 192px);
            }
        }

        Text {
            text: "›";
            font-size: 24px;
            color: white;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

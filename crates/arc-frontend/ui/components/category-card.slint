import { Palette } from "std-widgets.slint";
import { CategoryItem } from "../types.slint";

export component CategoryCard inherits Rectangle {
    in property <CategoryItem> category;
    callback clicked(string);

    border-radius: 12px;
    background: root.category.bg-color;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(root.category.id); }
    }

    // Subtle hover overlay
    if ta.has-hover: Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: parent.border-radius;
        background: #ffffff12;
    }

    HorizontalLayout {
        padding: 14px;
        spacing: 12px;
        alignment: start;

        Rectangle {
            width: 38px;
            height: 38px;
            vertical-stretch: 0;
            background: transparent;
            Image {
                source: root.category.icon;
                width: 38px;
                height: 38px;
                image-fit: contain;
            }
        }

        Text {
            text: root.category.label;
            font-weight: 600;
            font-size: 14px;
            color: white;
            vertical-alignment: center;
        }
    }
}

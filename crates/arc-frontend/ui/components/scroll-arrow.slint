import { Theme } from "../theme.slint";

export component ScrollArrow inherits Rectangle {
    in property <bool> points-left: true;
    in property <bool> active: true;
    in property <color> icon-color: Theme.on-image;
    in property <length> icon-size: 14px;
    in property <bool> shadow: false;

    callback activated();

    width: 40px;
    height: 40px;
    border-radius: self.width / 2;
    background: Theme.overlay-control;
    drop-shadow-blur: root.shadow ? 8px : 0px;
    drop-shadow-color: root.shadow ? Colors.black.transparentize(0.8) : transparent;
    opacity: root.active ? 1.0 : 0.0;
    animate opacity { duration: 150ms; }

    TouchArea {
        enabled: root.active;
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }

    Image {
        source: root.points-left
            ? @image-url("../../assets/chevron-left.svg")
            : @image-url("../../assets/chevron-right.svg");
        width: root.icon-size;
        height: root.icon-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
        colorize: root.icon-color;
    }
}

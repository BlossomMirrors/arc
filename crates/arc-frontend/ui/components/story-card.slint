import { Palette } from "std-widgets.slint";
import { StoryItem } from "../types.slint";

export component StoryCard inherits Rectangle {
    in property <StoryItem> story;
    callback clicked(string);

    width: 300px;
    height: 210px;
    border-radius: 14px;
    clip: true;
    background: Palette.alternate-background;

    ta := TouchArea {
        clicked => {
            root.clicked(root.story.id);
        }
    }

    // Background screenshot
    if root.story.screenshot.width > 0: Image {
        source: root.story.screenshot;
        width: parent.width;
        height: parent.height;
        image-fit: cover;
        opacity: 0.9;
    }

    // Fallback solid tint when no screenshot loaded yet
    if root.story.screenshot.width == 0: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #1a1a2e;
    }

    // Bottom gradient overlay
    Rectangle {
        x: 0;
        y: parent.height - 110px;
        width: parent.width;
        height: 110px;
        background: @linear-gradient(180deg, transparent 0%, #000000d0 100%);
    }

    // Top gradient (subtle)
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 40px;
        background: @linear-gradient(180deg, #00000055 0%, transparent 100%);
    }

    // Story title (bottom)
    Text {
        x: 12px;
        y: parent.height - 50px;
        width: parent.width - 24px;
        text: root.story.title;
        font-size: 15px;
        font-weight: 700;
        color: white;
        wrap: word-wrap;
        overflow: elide;
    }

    // Hover highlight border
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: parent.border-radius;
        border-width: ta.has-hover ? 2px : 1px;
        border-color: ta.has-hover ? #ffffff44 : #ffffff18;
        background: transparent;
        animate border-width { duration: 100ms; }
    }
}

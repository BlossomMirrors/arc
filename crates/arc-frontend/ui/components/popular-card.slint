import { AppCardData } from "../types.slint";
import { AppCard } from "app-card.slint";

// Thin wrapper — PopularCard is AppCard with is-small: true.
export component PopularCard inherits Rectangle {
    in property <AppCardData> card;
    callback clicked(string);

    AppCard {
        width: parent.width;
        height: parent.height;
        card: root.card;
        is-small: true;
        clicked(id) => { root.clicked(id); }
    }
}

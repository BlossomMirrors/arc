import { Theme } from "../theme.slint";
import { AppIcon } from "app-icon.slint";
import { ActionButton, ActionButtonKind } from "action-button.slint";
import { ModalDialog } from "modal-dialog.slint";

export component RemoveDialog inherits ModalDialog {
    in property <image> icon;
    in property <string> name;
    in property <string> pkg-id;
    in-out property <bool> delete-data: true;

    in property <string> tr-uninstall: "Uninstall";
    in property <string> tr-uninstall-title-prefix: "Uninstall ";
    in property <string> tr-uninstall-title-suffix: "";
    in property <string> tr-cancel: "Cancel";
    in property <string> tr-delete-data: "Also delete app data";
    in property <string> tr-delete-data-desc: "Removes settings and saved data";

    callback cancelled();
    callback confirmed(string, bool);

    dismissed => {
        root.cancelled();
    }

    HorizontalLayout {
        spacing: 14px;
        alignment: start;

        AppIcon {
            size: 48px;
            icon: root.icon;
            icon-size: 40px;
            outlined: true;
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.tr-uninstall-title-prefix + root.name + root.tr-uninstall-title-suffix + "?";
                font-size: 15px;
                font-weight: 700;
                overflow: elide;
            }

            Text {
                text: root.pkg-id;
                font-size: 11px;
                color: Theme.fg.transparentize(0.5);
                overflow: elide;
            }
        }
    }

    Rectangle {
        height: 48px;
        border-radius: 8px;
        background: delete-data-ta.has-hover ? Theme.surface : transparent;
        border-width: 1px;
        border-color: Theme.control;

        delete-data-ta := TouchArea {
            clicked => {
                root.delete-data = !root.delete-data;
            }
        }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 12px;
            alignment: start;

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;

                Rectangle {
                    width: 18px;
                    height: 18px;
                    border-radius: 4px;
                    border-width: 1.5px;
                    border-color: root.delete-data ? Theme.danger : Theme.control-strong;
                    background: root.delete-data ? Theme.danger : transparent;

                    Text {
                        text: "✓";
                        color: white;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        opacity: root.delete-data ? 1 : 0;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 1px;

                Text {
                    text: root.tr-delete-data;
                    font-size: 13px;
                    font-weight: 500;
                    color: Theme.fg.transparentize(0.1);
                }

                Text {
                    text: root.tr-delete-data-desc;
                    font-size: 11px;
                    color: Theme.fg-dim;
                }
            }
        }
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: end;

        ActionButton {
            kind: ActionButtonKind.secondary;
            text: root.tr-cancel;
            clicked => {
                root.cancelled();
            }
        }

        ActionButton {
            kind: ActionButtonKind.danger;
            text: root.tr-uninstall;
            clicked => {
                root.confirmed(root.pkg-id, root.delete-data);
            }
        }
    }
}

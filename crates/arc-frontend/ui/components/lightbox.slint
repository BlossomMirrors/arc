import { Theme } from "../theme.slint";
import { ScrollArrow } from "scroll-arrow.slint";

// Instantiate with `if visible:` so each opening starts fresh at initial-index.
export component Lightbox inherits Rectangle {
    in property <[image]> images;
    in property <int> initial-index;

    callback closed();

    // Bound to initial-index until the first prev/next click breaks the binding.
    private property <int> current-index: root.initial-index;

    background: Colors.black.transparentize(0.33);

    TouchArea {
        clicked => {
            root.closed();
        }
    }

    // No touch area so taps fall through to the backdrop and dismiss.
    Image {
        source: root.images[root.current-index];
        x: parent.width * 0.05;
        y: parent.height * 0.05;
        width: parent.width * 0.9;
        height: parent.height * 0.9;
        image-fit: contain;
    }

    ScrollArrow {
        x: 16px;
        y: (parent.height - self.height) / 2;
        width: 48px;
        height: 48px;
        border-radius: 24px;
        icon-size: 20px;
        background: Colors.black.transparentize(0.47);
        points-left: true;
        active: root.current-index > 0;
        activated => {
            root.current-index -= 1;
        }
    }

    ScrollArrow {
        x: parent.width - self.width - 16px;
        y: (parent.height - self.height) / 2;
        width: 48px;
        height: 48px;
        border-radius: 24px;
        icon-size: 20px;
        background: Colors.black.transparentize(0.47);
        points-left: false;
        active: root.current-index < root.images.length - 1;
        activated => {
            root.current-index += 1;
        }
    }

    Rectangle {
        x: parent.width - self.width - 16px;
        y: 16px;
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background: lb-close-ta.has-hover ? Theme.scrim-strong : Colors.black.transparentize(0.47);

        lb-close-ta := TouchArea {
            clicked => {
                root.closed();
            }
        }

        Text {
            text: "×";
            font-size: 22px;
            color: Theme.on-image;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

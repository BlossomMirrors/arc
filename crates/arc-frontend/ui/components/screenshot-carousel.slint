import { Theme } from "../theme.slint";
import { HScroller } from "h-scroller.slint";

export component ScreenshotCarousel inherits Rectangle {
    in property <[image]> screenshots;

    callback screenshot-clicked(int);

    property <length> card-slot: 330px;

    height: 220px;
    preferred-width: 0px;

    HScroller {
        width: parent.width;
        height: parent.height;
        content-width: root.screenshots.length * root.card-slot;
        step: root.card-slot;
        arrow-width: 32px;
        arrow-height: 48px;
        arrow-radius: 8px;
        arrow-icon-size: 16px;

        for shot[i] in root.screenshots: Rectangle {
            x: i * root.card-slot + 5px;
            y: (parent.height - self.height) / 2;
            width: 320px;
            height: 200px;
            border-radius: 8px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.surface-border;
            clip: true;

            Image {
                source: shot;
                width: parent.width;
                height: parent.height;
                image-fit: cover;
            }

            TouchArea {
                clicked => {
                    root.screenshot-clicked(i);
                }
            }
        }
    }
}

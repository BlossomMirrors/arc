import {
    VerticalBox,
    HorizontalBox,
    Button,
    CheckBox,
    LineEdit,
    ScrollView,
} from "std-widgets.slint";
import { Palette } from "std-widgets.slint";
import { RemoteItem } from "../types.slint";

component SectionLabel inherits HorizontalBox {
    in property <string> text: "";
    padding-top: 20px;
    padding-bottom: 6px;
    padding-right: 0px;
    spacing: 0px;

    Text {
        text: root.text;
        font-size: 10px;
        font-weight: 700;
        color: Palette.foreground.transparentize(0.45);
        letter-spacing: 0.8px;
    }
}

export component SettingsScreen inherits Rectangle {
    in-out property <string> settings-preferred: "Flatpak";
    in-out property <bool> settings-ignore-native-pref: false;
    in-out property <bool> settings-auto-updates: true;
    in-out property <int> settings-concurrent-downloads: 3;
    in-out property <bool> settings-show-security-warnings: true;
    in-out property <[RemoteItem]> settings-remotes: [];
    in-out property <bool> settings-remotes-loading: false;

    in property <string> tr-settings: "Settings";
    in property <string> tr-general: "GENERAL";
    in property <string> tr-auto-updates: "Auto-updates";
    in property <string> tr-auto-updates-desc: "Automatically update installed apps in the background";
    in property <string> tr-security-warnings: "Security warnings";
    in property <string> tr-security-warnings-desc: "Show warnings when installing third-party software or adding repositories";
    in property <string> tr-downloads-section: "DOWNLOADS";
    in property <string> tr-concurrent: "Concurrent downloads";
    in property <string> tr-concurrent-desc: "Maximum number of simultaneous downloads (1-16)";
    in property <string> tr-repositories: "REPOSITORIES";
    in property <string> tr-loading-ellipsis: "Loading…";
    in property <string> tr-protected: "Protected";
    in property <string> tr-remove: "Remove";
    in property <string> tr-add-repo-section: "ADD REPOSITORY";
    in property <string> tr-name: "Name";
    in property <string> tr-url: "URL";
    in property <string> tr-add-repo: "Add Repository";
    in property <string> tr-danger-zone: "DANGER ZONE";
    in property <string> tr-force-updates: "Force updates";
    in property <string> tr-force-updates-desc: "Runs flatpak update -y directly, bypassing the daemon";
    in property <string> tr-force-update: "Force Update";
    in property <string> tr-restart-daemon: "Restart daemon";
    in property <string> tr-restart-daemon-desc: "Kills the running arc-daemon and starts a fresh one in the background";
    in property <string> tr-restart: "Restart";

    callback back-clicked();
    callback save-settings(string, bool, bool, int, bool);
    callback load-remotes();
    callback add-remote(string, string);
    callback remove-remote(string);
    callback force-update-requested();
    callback restart-daemon-requested();

    property <string> new-repo-name: "";
    property <string> new-repo-url: "";
    property <bool> danger-zone-open: false;

    init => {
        root.load-remotes();
    }

    ScrollView {
        width: parent.width;
        height: parent.height;

        VerticalBox {
            width: parent.width;
            padding: 20px;
            spacing: 0px;

            // Header
            HorizontalBox {
                padding-left: 10px;
                padding-right: 0;
                padding-bottom: 16px;
                spacing: 12px;
                alignment: start;
                Text {
                    text: root.tr-settings;
                    font-size: 20px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }

            // GENERAL
            SectionLabel {
                text: root.tr-general;
            }

            HorizontalBox {
                padding: 10px;
                padding-left: 20px;
                padding-right: 0;
                spacing: 12px;
                VerticalBox {
                    spacing: 2px;
                    padding: 0;
                    horizontal-stretch: 1;
                    Text {
                        text: root.tr-auto-updates;
                    }

                    Text {
                        text: root.tr-auto-updates-desc;
                        font-size: 11px;
                        color: Palette.foreground.transparentize(0.4);
                        wrap: word-wrap;
                    }
                }

                VerticalBox {
                    alignment: center;
                    padding: 0;
                    horizontal-stretch: 0;
                    CheckBox {
                        checked: root.settings-auto-updates;
                        toggled => {
                            root.settings-auto-updates = self.checked;
                            root.save-settings(root.settings-preferred, root.settings-ignore-native-pref, root.settings-auto-updates, root.settings-concurrent-downloads, root.settings-show-security-warnings);
                        }
                    }
                }
            }

            HorizontalBox {
                padding: 10px;
                padding-left: 20px;
                padding-right: 0;
                spacing: 12px;
                VerticalBox {
                    spacing: 2px;
                    padding: 0;
                    horizontal-stretch: 1;
                    Text {
                        text: root.tr-security-warnings;
                    }

                    Text {
                        text: root.tr-security-warnings-desc;
                        font-size: 11px;
                        color: Palette.foreground.transparentize(0.4);
                        wrap: word-wrap;
                    }
                }

                VerticalBox {
                    alignment: center;
                    padding: 0;
                    horizontal-stretch: 0;
                    CheckBox {
                        checked: root.settings-show-security-warnings;
                        toggled => {
                            root.settings-show-security-warnings = self.checked;
                            root.save-settings(root.settings-preferred, root.settings-ignore-native-pref, root.settings-auto-updates, root.settings-concurrent-downloads, root.settings-show-security-warnings);
                        }
                    }
                }
            }

            // DOWNLOADS
            SectionLabel {
                text: root.tr-downloads-section;
                padding-bottom: 0px;
            }

            HorizontalBox {
                padding: 10px;
                padding-left: 20px;
                padding-right: 0;
                spacing: 12px;
                VerticalBox {
                    spacing: 2px;
                    padding: 0;
                    horizontal-stretch: 1;
                    Text {
                        text: root.tr-concurrent;
                    }

                    Text {
                        text: root.tr-concurrent-desc;
                        font-size: 11px;
                        color: Palette.foreground.transparentize(0.4);
                    }
                }

                HorizontalBox {
                    spacing: 4px;
                    alignment: end;

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: Palette.border;
                        background: dec-ta.has-hover ? Palette.background.darker(8%) : transparent;
                        dec-ta := TouchArea {
                            clicked => {
                                if root.settings-concurrent-downloads > 1 {
                                    root.settings-concurrent-downloads -= 1;
                                }
                                root.save-settings(root.settings-preferred, root.settings-ignore-native-pref, root.settings-auto-updates, root.settings-concurrent-downloads, root.settings-show-security-warnings);
                            }
                        }

                        Text {
                            text: "−";
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-size: 14px;
                        }
                    }

                    Rectangle {
                        width: 32px;
                        height: 28px;
                        Text {
                            text: root.settings-concurrent-downloads;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-size: 14px;
                            font-weight: 600;
                        }
                    }

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: Palette.border;
                        background: inc-ta.has-hover ? Palette.background.darker(8%) : transparent;
                        inc-ta := TouchArea {
                            clicked => {
                                if root.settings-concurrent-downloads < 16 {
                                    root.settings-concurrent-downloads += 1;
                                }
                                root.save-settings(root.settings-preferred, root.settings-ignore-native-pref, root.settings-auto-updates, root.settings-concurrent-downloads, root.settings-show-security-warnings);
                            }
                        }

                        Text {
                            text: "+";
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-size: 14px;
                        }
                    }
                }
            }

            // REPOSITORIES
            HorizontalBox {
                padding-right: 0;
                padding-top: 20px;
                padding-bottom: 6px;
                alignment: start;
                Text {
                    text: root.tr-repositories;
                    font-size: 10px;
                    font-weight: 700;
                    color: Palette.foreground.transparentize(0.45);
                    letter-spacing: 0.8px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                if root.settings-remotes-loading: Text {
                    text: root.tr-loading-ellipsis;
                    font-size: 11px;
                    color: Palette.foreground.transparentize(0.4);
                    vertical-alignment: center;
                }
            }

            for repo in root.settings-remotes: HorizontalBox {
                padding: 8px;
                padding-left: 20px;
                padding-right: 0;
                spacing: 12px;
                VerticalBox {
                    spacing: 2px;
                    padding: 0;
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: repo.name;
                        font-weight: 600;
                        overflow: elide;
                    }

                    Text {
                        text: repo.url;
                        font-size: 11px;
                        color: Palette.foreground.transparentize(0.4);
                        overflow: elide;
                    }
                }

                if repo.protected: VerticalBox {
                    alignment: center;
                    padding: 0;
                    horizontal-stretch: 0;
                    Rectangle {
                        width: 72px;
                        height: 24px;
                        border-radius: 4px;
                        background: Palette.foreground.transparentize(0.88);
                        Text {
                            text: root.tr-protected;
                            font-size: 10px;
                            color: Palette.foreground.transparentize(0.4);
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if !repo.protected: VerticalBox {
                    alignment: center;
                    padding: 0;
                    horizontal-stretch: 0;
                    Button {
                        text: root.tr-remove;
                        clicked => {
                            root.remove-remote(repo.name);
                        }
                    }
                }
            }

            // ADD REPOSITORY
            SectionLabel {
                text: root.tr-add-repo-section;
            }

            HorizontalBox {
                padding: 8px;
                padding-left: 20px;
                padding-right: 0;
                spacing: 12px;
                Text {
                    text: root.tr-name;
                    vertical-alignment: center;
                    min-width: 48px;
                }

                LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: "my-repo";
                    text <=> root.new-repo-name;
                }
            }

            HorizontalBox {
                padding: 8px;
                padding-left: 20px;
                padding-right: 0;
                spacing: 12px;
                Text {
                    text: root.tr-url;
                    vertical-alignment: center;
                    min-width: 48px;
                }

                LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: "https://example.com/repo";
                    text <=> root.new-repo-url;
                }
            }

            HorizontalBox {
                padding-left: 20px;
                padding-right: 0;
                padding-top: 8px;
                padding-bottom: 4px;
                alignment: start;
                Button {
                    text: root.tr-add-repo;
                    enabled: root.new-repo-name != "" && root.new-repo-url != "";
                    clicked => {
                        root.add-remote(root.new-repo-name, root.new-repo-url);
                        root.new-repo-name = "";
                        root.new-repo-url = "";
                    }
                }
            }

            // DANGER ZONE (collapsible)
            Rectangle {
                height: dz-header.preferred-height;

                dz-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.danger-zone-open = !root.danger-zone-open; }
                }

                dz-header := HorizontalBox {
                    padding-right: 0;
                    padding-top: 28px;
                    padding-bottom: 6px;

                    Text {
                        text: root.tr-danger-zone;
                        font-size: 10px;
                        font-weight: 700;
                        color: #ef4444;
                        letter-spacing: 0.8px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Text {
                        text: root.danger-zone-open ? "▲" : "▼";
                        font-size: 9px;
                        color: white;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                clip: true;
                height: root.danger-zone-open ? dz-content.preferred-height : 0px;
                animate height { duration: 200ms; easing: ease-in-out; }

                dz-content := VerticalLayout {
                    spacing: 0px;

                    HorizontalBox {
                        padding: 10px;
                        padding-left: 20px;
                        padding-right: 0;
                        spacing: 12px;

                        VerticalBox {
                            spacing: 2px;
                            padding: 0;
                            horizontal-stretch: 1;
                            Text { text: root.tr-force-updates; }
                            Text {
                                text: root.tr-force-updates-desc;
                                font-size: 11px;
                                color: Palette.foreground.transparentize(0.4);
                                wrap: word-wrap;
                            }
                        }

                        VerticalBox {
                            alignment: center;
                            padding: 0;
                            horizontal-stretch: 0;

                            Rectangle {
                                width: 110px;
                                height: 30px;
                                border-radius: 7px;
                                background: force-ta.has-hover ? #dc2626 : #ef4444;

                                force-ta := TouchArea {
                                    clicked => { root.force-update-requested(); }
                                }

                                Text {
                                    text: root.tr-force-update;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: white;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    HorizontalBox {
                        padding: 10px;
                        padding-left: 20px;
                        padding-right: 0;
                        spacing: 12px;

                        VerticalBox {
                            spacing: 2px;
                            padding: 0;
                            horizontal-stretch: 1;
                            Text { text: root.tr-restart-daemon; }
                            Text {
                                text: root.tr-restart-daemon-desc;
                                font-size: 11px;
                                color: Palette.foreground.transparentize(0.4);
                                wrap: word-wrap;
                            }
                        }

                        VerticalBox {
                            alignment: center;
                            padding: 0;
                            horizontal-stretch: 0;

                            Rectangle {
                                width: 110px;
                                height: 30px;
                                border-radius: 7px;
                                background: restart-ta.has-hover ? #dc2626 : #ef4444;

                                restart-ta := TouchArea {
                                    clicked => { root.restart-daemon-requested(); }
                                }

                                Text {
                                    text: root.tr-restart;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: white;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

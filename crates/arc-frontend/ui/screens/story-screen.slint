import { Palette, ScrollView } from "std-widgets.slint";
import { StoryItem } from "../types.slint";

export component StoryScreen inherits Rectangle {
    in property <StoryItem> story;
    in property <string> tr-back: "Back";

    callback back-clicked();

    clip: true;

    VerticalLayout {
        spacing: 0px;

        // Hero image -- outside the ScrollView so it gets root.width, not visible-width
        Rectangle {
            width: parent.width;
            height: 280px;
            clip: true;
            background: #1a1a2e;

            if root.story.screenshot.width > 0: Image {
                source: root.story.screenshot;
                width: parent.width;
                height: parent.height;
                image-fit: cover;
                opacity: 0.9;
            }

            // Bottom gradient blending into page background
            Rectangle {
                x: 0;
                y: parent.height - 100px;
                width: parent.width;
                height: 100px;
                background: @linear-gradient(180deg, transparent 0%, Palette.background 100%);
            }

            // Top gradient (back button legibility)
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 60px;
                background: @linear-gradient(180deg, #00000066 0%, transparent 100%);
            }

            // Back button
            Rectangle {
                x: 12px;
                y: 12px;
                width: back-lbl.preferred-width + 28px;
                height: 34px;
                border-radius: 17px;
                background: back-ta.has-hover ? #00000088 : #00000066;
                border-width: 1px;
                border-color: #ffffff30;

                back-ta := TouchArea {
                    clicked => { root.back-clicked(); }
                }

                back-lbl := Text {
                    text: root.tr-back;
                    color: white;
                    font-size: 13px;
                    font-weight: 600;
                    x: (parent.width - self.preferred-width) / 2;
                    y: (parent.height - self.preferred-height) / 2;
                }
            }
        }

        // Scrollable content area
        scroller := ScrollView {
            vertical-stretch: 1;
            viewport-width: self.visible-width;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;
                width: scroller.visible-width;

                // Story title
                Text {
                    text: root.story.title;
                    font-size: 26px;
                    font-weight: 800;
                    wrap: word-wrap;
                    color: Palette.foreground;
                }

                // Story body
                if root.story.body != "": Text {
                    text: root.story.body;
                    font-size: 14px;
                    color: Palette.foreground.transparentize(0.2);
                    wrap: word-wrap;
                }

                // Bottom padding
                Rectangle { height: 32px; }
            }
        }
    }
}

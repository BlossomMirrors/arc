import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { StoryItem } from "../types.slint";
import { AppCard } from "../components/app-card.slint";
import { AppIcon } from "../components/app-icon.slint";

export component StoryScreen inherits Rectangle {
    in property <StoryItem> story;
    in property <string> tr-installed: "Installed";

    callback back-clicked();
    callback app-clicked(string);

    clip: true;

    VerticalLayout {
        spacing: 0px;

        // Hero image -- full width, outside the ScrollView
        Rectangle {
            width: parent.width;
            height: 280px;
            clip: true;
            background: Theme.card-deep-2;

            if root.story.screenshot.width > 0: Image {
                source: root.story.screenshot;
                width: parent.width;
                height: parent.height;
                image-fit: cover;
                opacity: 0.9;
            }

            // Bottom gradient blending into page background
            Rectangle {
                x: 0;
                y: parent.height - 100px;
                width: parent.width;
                height: 100px;
                background: @linear-gradient(180deg, transparent 0%, Theme.window-bg 100%);
            }

            // Top gradient (back button legibility)
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 60px;
                background: @linear-gradient(180deg, Theme.scrim 0%, transparent 100%);
            }
        }

        // Scrollable content
        scroller := ScrollView {
            vertical-stretch: 1;
            viewport-width: self.visible-width;

            VerticalLayout {
                padding: 24px;
                spacing: 0px;
                alignment: start;
                width: min(scroller.visible-width, 740px);
                x: (scroller.visible-width - self.width) / 2;

                // Story title
                Text {
                    text: root.story.title;
                    font-size: 26px;
                    font-weight: 800;
                    wrap: word-wrap;
                    color: Theme.fg;
                }

                // Description blocks (HTML body parsed into paragraphs/headings/images/app-links)
                for block in root.story.description-blocks: Rectangle {
                    width: parent.width;
                    height: block.is-image ? (parent.width * 9 / 16 + 20px) : block.is-app ? (block.app-card.id != "" ? 88px : 0px) : (block-text.preferred-height + (block.is-heading ? 24px : 12px));

                    // Text (zero-width/zero-text for image and app blocks)
                    block-text := Text {
                        x: 0;
                        y: block.is-heading ? 16px : 8px;
                        width: (block.is-image || block.is-app) ? 0px : parent.width;
                        text: (block.is-image || block.is-app) ? "" : block.text;
                        font-size: block.is-heading ? 16px : 14px;
                        font-weight: block.is-heading ? 700 : (block.is-bold ? 600 : 400);
                        color: block.is-heading ? Theme.fg : Theme.fg.transparentize(0.2);
                        wrap: word-wrap;
                    }

                    // Image (only rendered for image blocks)
                    if block.is-image: Rectangle {
                        y: 0px;
                        width: parent.width;
                        height: parent.width * 9 / 16;
                        border-radius: 10px;
                        clip: true;
                        background: Theme.alternate-bg;

                        if block.image.width > 0: Image {
                            source: block.image;
                            width: parent.width;
                            height: parent.height;
                            image-fit: cover;
                        }
                    }

                    // Alt text caption below image
                    if block.is-image && block.text != "": Text {
                        x: 0;
                        y: parent.width * 9 / 16 + 4px;
                        width: parent.width;
                        text: block.text;
                        font-size: 11px;
                        color: Theme.fg.transparentize(0.5);
                        horizontal-alignment: center;
                    }

                    // Inline app card
                    if block.is-app && block.app-card.id != "": Rectangle {
                        x: 0;
                        y: 8px;
                        width: parent.width;
                        height: 72px;
                        border-radius: 12px;
                        background: app-link-ta.has-hover ? Theme.alternate-bg.darker(0.03) : Theme.alternate-bg;
                        border-width: 1px;
                        border-color: Theme.fg.transparentize(0.9);

                        app-link-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.app-clicked(block.app-card.id);
                            }
                        }

                        HorizontalLayout {
                            padding: 12px;
                            spacing: 12px;
                            alignment: start;

                            AppIcon {
                                size: 48px;
                                icon: block.app-card.icon;
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;

                                Text {
                                    text: block.app-card.name;
                                    font-size: 14px;
                                    font-weight: 700;
                                    overflow: elide;
                                    color: Theme.fg;
                                }

                                Text {
                                    text: block.app-card.summary;
                                    font-size: 12px;
                                    color: Theme.fg.transparentize(0.45);
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }

                // Featured apps
                if root.story.featured-apps.length > 0: VerticalLayout {
                    spacing: 10px;
                    padding-top: 20px;

                    for app[i] in root.story.featured-apps: Rectangle {
                        height: 96px;
                        border-radius: 12px;
                        background: app-ta.has-hover ? Theme.alternate-bg.darker(0.03) : Theme.alternate-bg;
                        border-width: 1px;
                        border-color: Theme.fg.transparentize(0.9);

                        app-ta := TouchArea {
                            clicked => {
                                root.app-clicked(app.id);
                            }
                        }

                        HorizontalLayout {
                            padding: 16px;
                            spacing: 16px;
                            alignment: start;

                            AppIcon {
                                size: 56px;
                                icon: app.icon;
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;

                                Text {
                                    text: app.name;
                                    font-size: 15px;
                                    font-weight: 700;
                                    overflow: elide;
                                    color: Theme.fg;
                                }

                                Text {
                                    text: app.summary;
                                    font-size: 12px;
                                    color: Theme.fg.transparentize(0.45);
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }

                // Bottom padding
                Rectangle {
                    height: 32px;
                }
            }
        }
    }
}

import { Palette, ScrollView } from "std-widgets.slint";
import { StoryItem } from "../types.slint";
import { AppCard } from "../components/app-card.slint";

export component StoryScreen inherits Rectangle {
    in property <StoryItem> story;
    in property <string> tr-back: "Back";
    in property <string> tr-installed: "Installed";

    callback back-clicked();
    callback app-clicked(string);

    clip: true;

    VerticalLayout {
        spacing: 0px;

        // Hero image -- full width, outside the ScrollView
        Rectangle {
            width: parent.width;
            height: 280px;
            clip: true;
            background: #1a1a2e;

            if root.story.screenshot.width > 0: Image {
                source: root.story.screenshot;
                width: parent.width;
                height: parent.height;
                image-fit: cover;
                opacity: 0.9;
            }

            // Bottom gradient blending into page background
            Rectangle {
                x: 0;
                y: parent.height - 100px;
                width: parent.width;
                height: 100px;
                background: @linear-gradient(180deg, transparent 0%, Palette.background 100%);
            }

            // Top gradient (back button legibility)
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 60px;
                background: @linear-gradient(180deg, #00000066 0%, transparent 100%);
            }

            // Back button
            Rectangle {
                x: 12px;
                y: 12px;
                width: back-lbl.preferred-width + 28px;
                height: 34px;
                border-radius: 17px;
                background: back-ta.has-hover ? #00000088 : #00000066;
                border-width: 1px;
                border-color: #ffffff30;

                back-ta := TouchArea {
                    clicked => { root.back-clicked(); }
                }

                back-lbl := Text {
                    text: root.tr-back;
                    color: white;
                    font-size: 13px;
                    font-weight: 600;
                    x: (parent.width - self.preferred-width) / 2;
                    y: (parent.height - self.preferred-height) / 2;
                }
            }
        }

        // Scrollable content
        scroller := ScrollView {
            vertical-stretch: 1;
            viewport-width: self.visible-width;

            VerticalLayout {
                padding: 24px;
                spacing: 0px;
                width: scroller.visible-width;

                // Story title
                Text {
                    text: root.story.title;
                    font-size: 26px;
                    font-weight: 800;
                    wrap: word-wrap;
                    color: Palette.foreground;
                }

                // Description blocks (HTML body parsed into paragraphs/headings)
                for block in root.story.description-blocks: Rectangle {
                    width: parent.width;
                    height: block-text.preferred-height + (block.is-heading ? 24px : 12px);

                    block-text := Text {
                        x: 0;
                        y: block.is-heading ? 16px : 8px;
                        width: parent.width;
                        text: block.text;
                        font-size: block.is-heading ? 16px : 14px;
                        font-weight: block.is-heading ? 700 : (block.is-bold ? 600 : 400);
                        color: block.is-heading
                            ? Palette.foreground
                            : Palette.foreground.transparentize(0.2);
                        wrap: word-wrap;
                    }
                }

                // Featured apps
                if root.story.featured-apps.length > 0: VerticalLayout {
                    spacing: 10px;
                    padding-top: 20px;

                    for app[i] in root.story.featured-apps: Rectangle {
                        height: 96px;
                        border-radius: 12px;
                        background: app-ta.has-hover
                            ? Palette.alternate-background.darker(0.03)
                            : Palette.alternate-background;
                        border-width: 1px;
                        border-color: Palette.foreground.transparentize(0.9);

                        app-ta := TouchArea {
                            clicked => { root.app-clicked(app.id); }
                        }

                        HorizontalLayout {
                            padding: 16px;
                            spacing: 16px;
                            alignment: start;

                            // App icon
                            Rectangle {
                                width: 56px;
                                height: 56px;
                                border-radius: 12px;
                                background: #80808012;
                                border-width: 1px;
                                border-color: #80808025;

                                Image {
                                    source: app.icon;
                                    width: 44px;
                                    height: 44px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    image-fit: contain;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;

                                Text {
                                    text: app.name;
                                    font-size: 15px;
                                    font-weight: 700;
                                    overflow: elide;
                                    color: Palette.foreground;
                                }

                                Text {
                                    text: app.summary;
                                    font-size: 12px;
                                    color: Palette.foreground.transparentize(0.45);
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }

                // Bottom padding
                Rectangle { height: 32px; }
            }
        }
    }
}

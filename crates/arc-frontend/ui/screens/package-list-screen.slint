import { ListView, VerticalBox } from "std-widgets.slint";
import { Palette, HorizontalBox } from "std-widgets.slint";
import { PackageItem } from "../types.slint";
import { AppIcon } from "../components/app-icon.slint";
import { ConveyorLoader } from "../components/conveyor-loader.slint";

export component PackageListScreen inherits Rectangle {
    in property <[PackageItem]> packages;
    in property <bool> is-loading;
    in property <string> current-view;
    in property <image> icon-trash;
    in property <string> tr-loading: "Loading...";
    in property <string> tr-no-packages: "No packages found.\nSearch for an application to get started.";
    in property <string> tr-up-to-date: "Everything is up to date.";
    in property <string> tr-no-installed: "No applications installed.";
    in property <string> tr-install: "Install";
    in property <string> tr-update: "Update";
    in property <string> tr-cancel: "Cancel";
    in property <string> tr-installing: "Installing";

    callback detail-requested(string);
    callback install-requested(string);
    callback remove-requested(string);
    callback update-requested(string);
    callback cancel-requested(string);

    if root.is-loading: ConveyorLoader {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    if !root.is-loading && root.packages.length == 0: VerticalBox {
        alignment: center;
        Text {
            text: root.current-view == "search" ? root.tr-no-packages : (root.current-view == "updates" ? root.tr-up-to-date : root.tr-no-installed);
            horizontal-alignment: center;
            color: Palette.foreground.transparentize(0.4);
        }
    }

    if !root.is-loading && root.packages.length > 0: ListView {
        for pkg[i] in root.packages: Rectangle {
            height: i == 0 ? 84px : 72px;

            card := Rectangle {
                x: 16px;
                y: i == 0 ? 17px : 5px;
                width: parent.width - 32px;
                height: 62px;
                border-radius: 10px;
                background: row-ta.has-hover ? #80808028 : #80808016;
                border-width: 1px;
                border-color: row-ta.has-hover ? #80808040 : #80808028;
                clip: true;

                row-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if root.current-view != "updates" && !pkg.busy {
                            root.detail-requested(pkg.id);
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 12px;

                    VerticalLayout {
                        alignment: center;

                        AppIcon {
                            size: 40px;
                            icon: pkg.icon;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;

                        Text {
                            text: pkg.name != "" ? pkg.name : pkg.id;
                            font-size: 13px;
                            font-weight: 600;
                            overflow: elide;
                        }

                        Text {
                            text: pkg.description;
                            font-size: 11px;
                            color: Palette.foreground.transparentize(0.45);
                            overflow: elide;
                        }
                    }

                    // Normal state: version text + action button
                    if !pkg.busy: Text {
                        text: pkg.version;
                        font-size: 11px;
                        color: Palette.foreground.transparentize(0.5);
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        min-width: 60px;
                    }

                    if !pkg.busy: VerticalLayout {
                        alignment: center;

                        Rectangle {
                            width: pkg.installed && root.current-view != "updates" ? 30px : 80px;
                            height: 30px;
                            border-radius: 7px;
                            background: pkg.installed ? (action-ta.has-hover ? #dc2626 : #ef4444) : (action-ta.has-hover ? #80808035 : #80808020);
                            border-width: pkg.installed ? 0px : 1px;
                            border-color: #80808040;

                            action-ta := TouchArea {
                                clicked => {
                                    if root.current-view == "updates" {
                                        root.update-requested(pkg.id);
                                    } else if pkg.installed {
                                        root.remove-requested(pkg.id);
                                    } else {
                                        root.install-requested(pkg.id);
                                    }
                                }
                            }

                            if pkg.installed && root.current-view != "updates": Image {
                                source: root.icon-trash;
                                width: 14px;
                                height: 14px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                colorize: white;
                            }

                            if !pkg.installed || root.current-view == "updates": Text {
                                text: root.current-view == "updates" ? root.tr-update : root.tr-install;
                                font-size: 12px;
                                font-weight: 600;
                                color: Palette.foreground.transparentize(0.1);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Busy state: status label + cancel button
                    if pkg.busy: HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        Text {
                            text: root.tr-installing;
                            font-size: 11px;
                            color: Palette.foreground.transparentize(0.45);
                            vertical-alignment: center;
                        }

                        VerticalLayout {
                            alignment: center;

                            Rectangle {
                                width: busy-cancel-label.preferred-width + 20px;
                                height: 28px;
                                border-radius: 6px;
                                background: busy-cancel-ta.has-hover ? #dc2626 : #ef4444;

                                busy-cancel-ta := TouchArea {
                                    clicked => {
                                        root.cancel-requested(pkg.transaction-id);
                                    }
                                }

                                busy-cancel-label := Text {
                                    width: parent.width;
                                    height: parent.height;
                                    text: root.tr-cancel;
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: white;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Progress bar — same style and positioning as the transaction row
                if pkg.busy: Rectangle {
                    x: 66px;
                    y: parent.height - 10px;
                    width: parent.width - 66px - 18px;
                    height: 5px;
                    border-radius: 3px;
                    background: #80808028;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width * pkg.progress;
                        height: parent.height;
                        border-radius: 3px;
                        background: #3b82f6;
                        animate width {
                            duration: 600ms;
                            easing: ease-in-out;
                        }
                    }
                }
            }
        }
    }
}

import { Palette, ScrollView } from "std-widgets.slint";
import { TransactionItem, PackageItem } from "../types.slint";
import { TransactionRow } from "../components/transaction-row.slint";
import { UpdateRow } from "../components/update-row.slint";

export component DownloadManagerScreen inherits Rectangle {
    in property <[TransactionItem]> active-transactions: [];
    in property <[TransactionItem]> pending-transactions: [];
    in property <[TransactionItem]> completed-transactions: [];
    in property <[PackageItem]> available-updates: [];
    in property <bool> updates-loading: false;
    in property <bool> updates-all-queued: false;

    in property <string> tr-downloads: "Downloads & Updates";
    in property <string> tr-checking: "Checking...";
    in property <string> tr-check-updates: "Check for Updates";
    in property <string> tr-active-prefix: "Active (";
    in property <string> tr-pending-prefix: "Pending (";
    in property <string> tr-completed-prefix: "Completed (";
    in property <string> tr-clear-all: "Clear All";
    in property <string> tr-updates-available-prefix: "Updates Available (";
    in property <string> tr-update-all: "Update All";
    in property <string> tr-no-downloads: "No active downloads";
    in property <string> tr-downloads-empty: "Installs and updates will appear here";
    in property <string> tr-update: "Update";
    in property <string> tr-cancel: "Cancel";
    in property <string> tr-removed: "Removed";
    in property <string> tr-installed: "Installed";
    in property <string> tr-failed: "Failed";
    in property <string> tr-queued: "Queued";
    in property <string> tr-removing: "Removing";
    in property <string> tr-updating: "Updating";
    in property <string> tr-installing: "Installing";

    callback clear-completed-requested();
    callback update-all-requested();
    callback update-requested(string);
    callback refresh-updates-requested();
    callback cancel-requested(string);
    callback detail-requested(string);

    private property <bool> has-content:
        root.active-transactions.length > 0 || root.pending-transactions.length > 0 || root.completed-transactions.length > 0 || root.available-updates.length > 0;

    ScrollView {
        width: parent.width;
        height: parent.height;
        viewport-width: self.visible-width;

        VerticalLayout {
            spacing: 0px;
            width: min(parent.width, 900px);
            x: (parent.width - self.width) / 2;
            alignment: start;

            // Page header
            HorizontalLayout {
                padding-left: 30px;
                padding-right: 20px;
                padding-top: 20px;
                padding-bottom: 16px;
                spacing: 12px;

                Text {
                    text: root.tr-downloads;
                    font-size: 20px;
                    font-weight: 700;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }

                check-btn := Rectangle {
                    width: check-label.preferred-width + 24px;
                    height: 32px;
                    border-radius: 6px;
                    background: check-ta.has-hover && !root.updates-loading ? #80808018 : #00000000;
                    border-width: 1px;
                    border-color: #80808030;

                    check-ta := TouchArea {
                        enabled: !root.updates-loading;
                        clicked => {
                            root.refresh-updates-requested();
                        }
                    }

                    check-label := Text {
                        text: root.updates-loading ? root.tr-checking : root.tr-check-updates;
                        font-size: 12px;
                        color: root.updates-loading ? Palette.foreground.transparentize(0.5) : Palette.foreground.transparentize(0.1);
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            // Active
            if root.active-transactions.length > 0: VerticalLayout {
                spacing: 0px;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 16px;
                    padding-bottom: 8px;

                    Text {
                        text: root.tr-active-prefix + root.active-transactions.length + ")";
                        font-size: 11px;
                        font-weight: 700;
                        color: Palette.foreground.transparentize(0.4);
                        vertical-alignment: center;
                    }
                }

                for tx[i] in root.active-transactions: TransactionRow {
                    item: tx;
                    tr-removed: root.tr-removed; tr-installed: root.tr-installed;
                    tr-failed: root.tr-failed; tr-queued: root.tr-queued;
                    tr-removing: root.tr-removing; tr-updating: root.tr-updating;
                    tr-installing: root.tr-installing; tr-cancel: root.tr-cancel;
                    cancel-clicked(id) => { root.cancel-requested(id); }
                    detail-requested(id) => { root.detail-requested(id); }
                }
            }

            // Pending
            if root.pending-transactions.length > 0: VerticalLayout {
                spacing: 0px;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 16px;
                    padding-bottom: 8px;

                    Text {
                        text: root.tr-pending-prefix + root.pending-transactions.length + ")";
                        font-size: 11px;
                        font-weight: 700;
                        color: Palette.foreground.transparentize(0.4);
                        vertical-alignment: center;
                    }
                }

                for tx[i] in root.pending-transactions: TransactionRow {
                    item: tx;
                    tr-removed: root.tr-removed; tr-installed: root.tr-installed;
                    tr-failed: root.tr-failed; tr-queued: root.tr-queued;
                    tr-removing: root.tr-removing; tr-updating: root.tr-updating;
                    tr-installing: root.tr-installing; tr-cancel: root.tr-cancel;
                    cancel-clicked(id) => { root.cancel-requested(id); }
                    detail-requested(id) => { root.detail-requested(id); }
                }
            }

            // Completed
            if root.completed-transactions.length > 0: VerticalLayout {
                spacing: 0px;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 16px;
                    padding-bottom: 8px;
                    spacing: 12px;

                    Text {
                        text: root.tr-completed-prefix + root.completed-transactions.length + ")";
                        font-size: 11px;
                        font-weight: 700;
                        color: Palette.foreground.transparentize(0.4);
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }

                    clr-btn := Rectangle {
                        width: clr-label.preferred-width + 20px;
                        height: 24px;
                        border-radius: 5px;
                        background: clr-ta.has-hover ? #80808020 : #00000000;
                        border-width: 1px;
                        border-color: #80808028;

                        clr-ta := TouchArea {
                            clicked => {
                                root.clear-completed-requested();
                            }
                        }

                        clr-label := Text {
                            text: root.tr-clear-all;
                            font-size: 11px;
                            color: Palette.foreground.transparentize(0.3);
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                for tx[i] in root.completed-transactions: TransactionRow {
                    item: tx;
                    tr-removed: root.tr-removed; tr-installed: root.tr-installed;
                    tr-failed: root.tr-failed; tr-queued: root.tr-queued;
                    tr-removing: root.tr-removing; tr-updating: root.tr-updating;
                    tr-installing: root.tr-installing; tr-cancel: root.tr-cancel;
                    detail-requested(id) => { root.detail-requested(id); }
                }
            }

            // Updates Available
            if root.available-updates.length > 0: VerticalLayout {
                spacing: 0px;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 16px;
                    padding-bottom: 8px;
                    spacing: 12px;

                    Text {
                        text: root.tr-updates-available-prefix + root.available-updates.length + ")";
                        font-size: 11px;
                        font-weight: 700;
                        color: Palette.foreground.transparentize(0.4);
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }

                    upd-all-btn := Rectangle {
                        width: upd-all-label.preferred-width + 24px;
                        height: 24px;
                        border-radius: 5px;
                        background: root.updates-all-queued ? #2563eb60 : (upd-all-ta.has-hover ? #3b82f6 : #2563eb);

                        upd-all-ta := TouchArea {
                            enabled: !root.updates-all-queued;
                            clicked => {
                                root.update-all-requested();
                            }
                        }

                        upd-all-label := Text {
                            text: root.tr-update-all;
                            font-size: 11px;
                            font-weight: 600;
                            color: root.updates-all-queued ? #ffffff80 : white;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                for pkg[i] in root.available-updates: UpdateRow {
                    item: pkg;
                    tr-update: root.tr-update;
                    update-clicked(id) => {
                        root.update-requested(id);
                    }
                }
            }

            // Empty state
            if !root.has-content: VerticalLayout {
                alignment: center;
                spacing: 8px;
                padding-top: 80px;
                padding-bottom: 80px;

                Text {
                    text: root.tr-no-downloads;
                    font-size: 16px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    color: Palette.foreground.transparentize(0.4);
                }

                Text {
                    text: root.tr-downloads-empty;
                    font-size: 12px;
                    horizontal-alignment: center;
                    color: Palette.foreground.transparentize(0.55);
                }
            }
        }
    }
}

import { Theme } from "../theme.slint";
import { AppIcon } from "../components/app-icon.slint";
import { SecurityWarning } from "../components/security-warning.slint";
import { ActionButton } from "../components/action-button.slint";

export component InstallFlatpakrefScreen inherits Rectangle {
    in property <image> icon-package;
    in property <string> app-name;
    in property <string> app-id;
    in property <string> repo-url;
    in property <bool> show-security-warning: true;

    in property <string> tr-install-application: "Install Application";
    in property <string> tr-install: "Install";
    in property <string> tr-repo-warning: "Adding a third-party repository gives it the ability to distribute software to your system. Only add repositories from sources you trust.";

    callback confirmed();
    callback cancelled();

    VerticalLayout {
        alignment: center;
        padding: 48px;
        spacing: 20px;

        HorizontalLayout {
            alignment: center;
            AppIcon {
                size: 80px;
                icon: root.icon-package;
                icon-size: 44px;
                icon-colorize: Theme.fg.transparentize(0.15);
                outlined: true;
            }
        }

        Text {
            text: root.app-name != "" ? root.app-name : root.tr-install-application;
            font-size: 20px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            text: root.app-id;
            font-size: 12px;
            color: Theme.fg.transparentize(0.45);
            horizontal-alignment: center;
            overflow: elide;
        }

        Text {
            text: root.repo-url;
            font-size: 11px;
            color: Theme.fg.transparentize(0.55);
            horizontal-alignment: center;
            overflow: elide;
        }

        HorizontalLayout {
            alignment: center;
            ActionButton {
                width: 280px;
                height: 40px;
                border-radius: 10px;
                text: root.tr-install;
                clicked => {
                    root.confirmed();
                }
            }
        }

        if root.show-security-warning: HorizontalLayout {
            alignment: center;
            SecurityWarning {
                text: root.tr-repo-warning;
            }
        }
    }
}

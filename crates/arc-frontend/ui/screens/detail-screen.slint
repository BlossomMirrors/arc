import { Palette, HorizontalBox } from "std-widgets.slint";
import { AppDetailData } from "../types.slint";
import { DetailHeader } from "../components/detail-header.slint";
import { ScreenshotCarousel } from "../components/screenshot-carousel.slint";
import { DetailLightbox } from "../components/detail-lightbox.slint";

export component DetailScreen inherits Rectangle {
    in property <AppDetailData> detail-app;
    in property <bool> detail-loading;
    in property <bool> detail-busy;
    in property <[image]> detail-screenshots;
    in property <string> settings-preferred;

    callback back-clicked();
    callback install-requested(string);
    callback remove-requested(string);
    callback open-url-requested(string);

    private property <bool> lightbox-visible: false;
    private property <int> lightbox-index: 0;

    clip: true;

    if root.detail-loading: Rectangle {
        Text {
            text: "Loading...";
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if !root.detail-loading: Flickable {
        width: parent.width;
        height: parent.height;
        viewport-width: parent.width;
        viewport-height: content-layout.preferred-height + 32px;

        content-layout := VerticalLayout {
            spacing: 0px;
            width: parent.width;

            // Header: back button + app info + divider
            DetailHeader {
                detail-app: root.detail-app;
                detail-busy: root.detail-busy;
                settings-preferred: root.settings-preferred;
                back-clicked => {
                    root.back-clicked();
                }
                install-requested(id) => {
                    root.install-requested(id);
                }
                remove-requested(id) => {
                    root.remove-requested(id);
                }
            }

            // Short description
            if root.detail-app.summary != "": VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 16px;
                padding-bottom: 12px;

                Text {
                    text: root.detail-app.summary;
                    font-size: 13px;
                    wrap: word-wrap;
                    color: Palette.foreground.transparentize(0.1);
                }
            }

            // Full description (native/Lutris packages only)
            if root.detail-app.description != "": VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-bottom: 12px;

                Text {
                    text: root.detail-app.description;
                    font-size: 12px;
                    wrap: word-wrap;
                    color: Palette.foreground.transparentize(0.25);
                }
            }

            // Screenshots
            HorizontalBox {
                padding: 8px;
                if root.detail-screenshots.length > 0: ScreenshotCarousel {
                    screenshots: root.detail-screenshots;
                    screenshot-clicked(i) => {
                        root.lightbox-index = i;
                        root.lightbox-visible = true;
                    }
                }
            }

            // Homepage URL
            if root.detail-app.homepage-url != "": VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 8px;
                padding-bottom: 4px;

                Rectangle {
                    height: 1px;
                    background: #80808025;
                }

                HorizontalLayout {
                    padding-top: 12px;
                    spacing: 12px;
                    alignment: start;

                    Text {
                        text: "Website";
                        font-size: 12px;
                        font-weight: 600;
                        color: Palette.foreground.transparentize(0.3);
                        vertical-alignment: center;
                        min-width: 80px;
                    }

                    Rectangle {
                        horizontal-stretch: 1;

                        url-ta := TouchArea {
                            clicked => {
                                root.open-url-requested(root.detail-app.homepage-url);
                            }
                        }

                        Text {
                            text: root.detail-app.homepage-url;
                            font-size: 12px;
                            color: url-ta.has-hover ? #60a5fa : #3b82f6;
                            overflow: elide;
                            width: parent.width;
                        }
                    }
                }
            }
        }
    }

    // Lightbox
    if root.lightbox-visible: DetailLightbox {
        width: parent.width;
        height: parent.height;
        screenshots: root.detail-screenshots;
        initial-index: root.lightbox-index;
        closed => {
            root.lightbox-visible = false;
        }
    }
}

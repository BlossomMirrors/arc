import { VerticalBox, HorizontalBox, Button } from "std-widgets.slint";
import { AppDetailData } from "../types.slint";

export component DetailScreen inherits Rectangle {
    in property <AppDetailData> detail-app;
    in property <bool> detail-loading;
    in property <bool> detail-busy;
    in property <[image]> detail-screenshots;
    in property <string> settings-preferred;

    callback back-clicked();
    callback install-requested(string);
    callback remove-requested(string);

    clip: true;

    if root.detail-loading: VerticalBox {
        alignment: center;
        Text { text: "Loading..."; horizontal-alignment: center; }
    }

    if !root.detail-loading: Flickable {
        width: parent.width;
        height: parent.height;
        viewport-width: parent.width;
        viewport-height: 600px + (root.detail-screenshots.length > 0 ? 240px : 0px);

        VerticalBox {
            padding: 16px;
            spacing: 12px;
            width: parent.width;

            Button {
                text: "← Back";
                clicked => { root.back-clicked(); }
            }

            HorizontalBox {
                spacing: 16px;
                alignment: start;

                Image {
                    source: root.detail-app.icon;
                    width: 96px;
                    height: 96px;
                    image-fit: contain;
                }

                VerticalBox {
                    alignment: center;
                    spacing: 4px;
                    horizontal-stretch: 1;

                    Text { text: root.detail-app.name; font-size: 20px; font-weight: 700; overflow: elide; }
                    HorizontalBox {
                        spacing: 4px;
                        alignment: center;
                        Text { text: root.detail-app.developer; font-size: 13px; }
                        if root.detail-app.verified: Image {
                            source: @image-url("../../assets/verified.png");
                            width: 14px;
                            height: 14px;
                            vertical-alignment: center;
                            colorize: #0d6efd;
                        }
                    }
                    Text { text: root.detail-app.version; font-size: 11px; }
                }

                Button {
                    property <bool> only-lutris: root.detail-app.lutris-id != "" && root.detail-app.flatpak-id == "" && root.detail-app.native-id == "";
                    property <bool> only-native: root.detail-app.native-id != "" && root.detail-app.flatpak-id == "" && root.detail-app.lutris-id == "";
                    property <bool> is-lutris: root.detail-app.lutris-id != "" && (root.settings-preferred == "Lutris" || self.only-lutris);
                    property <bool> is-native: root.detail-app.native-id != "" && (root.settings-preferred == "Native" || self.only-native);
                    property <bool> is-flatpak: root.detail-app.flatpak-id != "" && (root.settings-preferred == "Flatpak" || (!self.is-lutris && !self.is-native));
                    property <bool> is-installed: self.is-lutris ? root.detail-app.lutris-installed : (self.is-native ? root.detail-app.native-installed : root.detail-app.flatpak-installed);
                    property <string> active-id: self.is-lutris ? root.detail-app.lutris-id : (self.is-native ? root.detail-app.native-id : root.detail-app.flatpak-id);

                    text: root.detail-busy ? "Working..." : (self.is-installed ? "Remove" : "Install");
                    enabled: self.active-id != "" && !root.detail-busy;
                    clicked => {
                        if self.is-installed {
                            root.remove-requested(self.active-id);
                        } else {
                            root.install-requested(self.active-id);
                        }
                    }
                }
            }

            Text { text: root.detail-app.summary; font-size: 13px; wrap: word-wrap; }
            Text { text: root.detail-app.description; font-size: 12px; wrap: word-wrap; }

            if root.detail-screenshots.length > 0: Flickable {
                width: parent.width;
                height: 220px;
                viewport-height: self.height;
                viewport-width: root.detail-screenshots.length * 330px;

                HorizontalBox {
                    spacing: 10px;
                    padding: 0px;
                    for shot in root.detail-screenshots: Image {
                        source: shot;
                        width: 320px;
                        height: 200px;
                        image-fit: contain;
                    }
                }
            }
        }
    }
}

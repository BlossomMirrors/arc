import { HorizontalBox, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { AppDetailData, ExtensionItem, DescriptionBlock } from "../types.slint";
import { DetailHeader } from "../components/detail-header.slint";
import { ScreenshotCarousel } from "../components/screenshot-carousel.slint";
import { Lightbox } from "../components/lightbox.slint";
import { ConveyorLoader } from "../components/conveyor-loader.slint";
import { ActionButton, ActionButtonKind } from "../components/action-button.slint";
import { ModalDialog } from "../components/modal-dialog.slint";

export component DetailScreen inherits Rectangle {
    in property <AppDetailData> detail-app;
    in property <bool> detail-loading;
    in property <bool> detail-busy;
    in property <float> detail-progress;
    in property <string> detail-transaction-id;
    in property <[image]> detail-screenshots;
    in property <string> settings-preferred;
    in property <[ExtensionItem]> detail-extensions;
    in property <[DescriptionBlock]> detail-description-blocks;
    in property <image> icon-trash;
    in property <string> tr-loading: "Loading...";
    in property <string> tr-website: "Website";
    in property <string> tr-extensions: "Extensions";
    in property <string> tr-install: "Install";
    in property <string> tr-remove: "Remove";
    in property <string> tr-run: "Run";
    in property <string> tr-cancel: "Cancel";
    in property <string> tr-working: "Working...";
    in property <string> tr-verified: "Verified developer";
    in property <string> tr-proprietary: "Proprietary";
    in property <string> tr-all-ages: "All ages";
    in property <string> tr-pwa: "PWA";

    callback back-clicked();
    callback install-requested(string);
    callback remove-requested(string);
    callback cancel-requested(string);
    callback launch-requested(string);
    callback open-url-requested(string);
    callback install-extension-requested(string);
    callback remove-extension-requested(string);
    callback eula-requested();

    private property <bool> lightbox-visible: false;
    private property <int> lightbox-index: 0;
    private property <bool> extensions-popup-visible: false;

    clip: true;

    if root.detail-loading: ConveyorLoader {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    if !root.detail-loading: ScrollView {
        width: parent.width;
        height: parent.height;
        viewport-width: self.visible-width;

        VerticalLayout {
            spacing: 0px;
            width: min(parent.width, 880px);
            x: (parent.width - self.width) / 2;
            padding-top: 20px;

            DetailHeader {
                detail-app: root.detail-app;
                detail-busy: root.detail-busy;
                detail-progress: root.detail-progress;
                detail-transaction-id: root.detail-transaction-id;
                settings-preferred: root.settings-preferred;
                has-extensions: root.detail-extensions.length > 0;
                icon-trash: root.icon-trash;
                tr-install: root.tr-install;
                tr-run: root.tr-run;
                tr-cancel: root.tr-cancel;
                tr-working: root.tr-working;
                tr-verified: root.tr-verified;
                tr-proprietary: root.tr-proprietary;
                tr-all-ages: root.tr-all-ages;
                tr-pwa: root.tr-pwa;
                back-clicked => {
                    root.back-clicked();
                }
                install-requested(id) => {
                    root.install-requested(id);
                }
                remove-requested(id) => {
                    root.remove-requested(id);
                }
                cancel-requested(id) => {
                    root.cancel-requested(id);
                }
                launch-requested(id) => {
                    root.launch-requested(id);
                }
                extensions-clicked => {
                    root.extensions-popup-visible = true;
                }
                eula-requested => {
                    root.eula-requested();
                }
            }

            if root.detail-app.summary != "": VerticalLayout {
                padding-left: 30px;
                padding-right: 30px;
                padding-top: 16px;
                padding-bottom: 12px;

                Text {
                    text: root.detail-app.summary;
                    font-size: 13px;
                    wrap: word-wrap;
                    color: Theme.fg.transparentize(0.1);
                }
            }

            if root.detail-screenshots.length > 0: HorizontalBox {
                padding-left: 30px;
                padding-right: 30px;
                padding-top: 8px;
                padding-bottom: 8px;
                ScreenshotCarousel {
                    screenshots: root.detail-screenshots;
                    screenshot-clicked(i) => {
                        root.lightbox-index = i;
                        root.lightbox-visible = true;
                    }
                }
            }

            if root.detail-description-blocks.length > 0: VerticalLayout {
                padding-left: 30px;
                padding-right: 30px;
                padding-top: 16px;
                padding-bottom: 12px;
                spacing: 4px;

                for block in root.detail-description-blocks: VerticalLayout {
                    if block.is-heading: Text {
                        text: block.text;
                        font-size: 13px;
                        font-weight: 700;
                        wrap: word-wrap;
                        color: Theme.fg.transparentize(0.05);
                    }
                    if !block.is-list-item && !block.is-heading: Text {
                        text: block.text;
                        font-size: 12px;
                        font-weight: block.is-bold ? 700 : 400;
                        wrap: word-wrap;
                        color: block.is-bold ? Theme.fg.transparentize(0.1) : Theme.fg.transparentize(0.25);
                    }
                    if block.is-list-item: HorizontalLayout {
                        padding-left: 8px;
                        spacing: 8px;
                        Text {
                            text: "•";
                            font-size: 12px;
                            color: Theme.fg.transparentize(0.25);
                            horizontal-stretch: 0;
                            vertical-alignment: top;
                            min-width: 10px;
                        }

                        Text {
                            text: block.text;
                            font-size: 12px;
                            font-weight: block.is-bold ? 700 : 400;
                            wrap: word-wrap;
                            color: block.is-bold ? Theme.fg.transparentize(0.1) : Theme.fg.transparentize(0.25);
                            horizontal-stretch: 1;
                        }
                    }
                }
            }

            if root.detail-app.homepage-url != "": VerticalLayout {
                padding-left: 30px;
                padding-right: 30px;
                padding-top: 8px;
                padding-bottom: 4px;

                Rectangle {
                    height: 1px;
                    background: Theme.surface-border;
                }

                HorizontalLayout {
                    padding-top: 12px;
                    spacing: 12px;
                    alignment: start;

                    Text {
                        text: root.tr-website;
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.fg.transparentize(0.3);
                        vertical-alignment: center;
                        min-width: 80px;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        url-ta := TouchArea {
                            clicked => {
                                root.open-url-requested(root.detail-app.homepage-url);
                            }
                        }

                        Text {
                            text: root.detail-app.homepage-url;
                            font-size: 12px;
                            color: url-ta.has-hover ? Theme.accent-light : Theme.accent;
                            overflow: elide;
                            width: parent.width;
                        }
                    }
                }
            }
        }
    }

    if root.lightbox-visible: Lightbox {
        width: parent.width;
        height: parent.height;
        images: root.detail-screenshots;
        initial-index: root.lightbox-index;
        closed => {
            root.lightbox-visible = false;
        }
    }

    if root.extensions-popup-visible: ModalDialog {
        width: parent.width;
        height: parent.height;
        panel-width: 480px;
        panel-height: min(root.detail-extensions.length * 60px + 88px, parent.height - 80px);
        panel-y: max(48px, (parent.height - self.panel-height) / 2);
        dismissed => {
            root.extensions-popup-visible = false;
        }

        HorizontalLayout {
            spacing: 8px;

            Text {
                text: root.tr-extensions;
                font-size: 16px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Rectangle {
                width: 28px;
                height: 28px;
                horizontal-stretch: 0;
                border-radius: 6px;
                background: close-ext-ta.has-hover ? Theme.surface-border : transparent;

                close-ext-ta := TouchArea {
                    clicked => {
                        root.extensions-popup-visible = false;
                    }
                }

                Text {
                    text: "✕";
                    font-size: 11px;
                    color: Theme.fg.transparentize(0.4);
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;
            viewport-width: self.visible-width;

            VerticalLayout {
                spacing: 4px;
                padding-bottom: 4px;

                for ext in root.detail-extensions: Rectangle {
                    height: 44px;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 12px;

                        Text {
                            text: ext.name;
                            font-size: 13px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }

                        if !ext.installed: ActionButton {
                            width: 80px;
                            height: 30px;
                            text: root.tr-install;
                            clicked => {
                                root.install-extension-requested(ext.id);
                            }
                        }

                        if ext.installed: ActionButton {
                            kind: ActionButtonKind.danger;
                            width: 80px;
                            height: 30px;
                            text: root.tr-remove;
                            clicked => {
                                root.remove-extension-requested(ext.id);
                            }
                        }
                    }
                }
            }
        }
    }
}

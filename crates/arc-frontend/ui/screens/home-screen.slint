import { VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { AppCard } from "../components/app-card.slint";
import { CategoryCard } from "../components/category-card.slint";
import { PopularCard } from "../components/popular-card.slint";
import { Carousel } from "../components/carousel.slint";
import { AppCardData, CategoryItem } from "../types.slint";

export component HomeScreen inherits Rectangle {
    in property <[AppCardData]> popular-apps;
    in property <[AppCardData]> recent-apps;
    in property <[CategoryItem]> categories;
    in property <bool> home-loading;
    in property <string> tr-loading: "Loading...";
    in property <string> tr-installed: "Installed";
    in property <string> tr-discover: "Discover Great Software";
    in property <string> tr-discover-sub: "Install apps from Flathub and your system repositories";
    in property <string> tr-popular: "Popular";
    in property <string> tr-recently-added: "Recently Added";
    in property <string> tr-categories: "Categories";

    callback detail-requested(string);
    callback category-selected(string);

    clip: true;

    if root.home-loading: VerticalBox {
        alignment: center;
        Text {
            text: root.tr-loading;
            horizontal-alignment: center;
        }
    }

    if !root.home-loading: scroller := ScrollView {
        width: parent.width;
        height: parent.height;
        viewport-width: self.visible-width;

        VerticalBox {
            padding: 16px;
            spacing: 0px;
            width: scroller.visible-width;

            Rectangle {
                height: 140px;
                border-radius: 12px;
                background: @linear-gradient(135deg, #5b7fa6, #8a5bab);

                VerticalBox {
                    alignment: center;
                    Text {
                        text: root.tr-discover;
                        font-size: 22px;
                        font-weight: 700;
                        color: white;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: root.tr-discover-sub;
                        font-size: 13px;
                        color: #ffffffcc;
                        horizontal-alignment: center;
                    }
                }
            }

            if root.popular-apps.length > 0: VerticalBox {
                padding-top: 20px;
                spacing: 4px;

                Text {
                    text: root.tr-popular;
                    font-size: 16px;
                    font-weight: 700;
                }

                Rectangle {
                    height: ceil(root.popular-apps.length / 5) * 164px;
                    preferred-width: 0px;

                    for app[i] in root.popular-apps: PopularCard {
                        x: mod(i, 5) * (parent.width + 12px) / 5;
                        y: ((i - mod(i, 5)) / 5) * 164px;
                        width: (parent.width + 12px) / 5 - 12px;
                        height: 152px;
                        card: app;
                        tr-installed: root.tr-installed;
                        clicked(id) => {
                            root.detail-requested(id);
                        }
                    }
                }
            }

            if root.recent-apps.length > 0: VerticalBox {
                padding-top: 20px;
                spacing: 8px;

                Text {
                    text: root.tr-recently-added;
                    font-size: 16px;
                    font-weight: 700;
                }

                Carousel {
                    width: parent.width;
                    items: root.recent-apps;
                    tr-installed: root.tr-installed;
                    item-clicked(id) => {
                        root.detail-requested(id);
                    }
                }
            }

            if root.categories.length > 0: VerticalBox {
                padding-top: 20px;
                spacing: 24px;

                Text {
                    text: root.tr-categories;
                    font-size: 16px;
                    font-weight: 700;
                }

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: min(parent.width, 750px);
                        height: ceil(root.categories.length / 3) * 114px;

                        for cat[i] in root.categories: CategoryCard {
                            x: mod(i, 3) * (parent.width + 12px) / 3;
                            y: ((i - mod(i, 3)) / 3) * 114px;
                            width: (parent.width + 12px) / 3 - 12px;
                            height: 104px;
                            category: cat;
                            clicked(id) => {
                                root.category-selected(id);
                            }
                        }
                    }
                }
            }
        }
    }
}

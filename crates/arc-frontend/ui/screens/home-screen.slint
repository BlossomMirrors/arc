import {
    VerticalBox,
    HorizontalBox,
    ScrollView,
    Palette,
} from "std-widgets.slint";
import { CategoryCard } from "../components/category-card.slint";
import { PopularCard } from "../components/popular-card.slint";
import { Carousel } from "../components/carousel.slint";
import { HeroCarousel } from "../components/hero-carousel.slint";
import { EditorialCard } from "../components/editorial-card.slint";
import {
    HomeItem,
    AppCardData,
    CategoryItem,
    StoryItem,
    HeroItem,
    LinkItem,
} from "../types.slint";

export component HomeScreen inherits Rectangle {
    in property <[HomeItem]> home-items;
    in property <[CategoryItem]> categories;
    in property <[StoryItem]> home-stories;
    in property <bool> home-loading;
    in property <string> tr-loading: "Loading...";
    in property <string> tr-installed: "Installed";
    in property <string> tr-categories: "Categories";
    in property <string> tr-recommended-apps: "Recommended Apps";

    callback detail-requested(string);
    callback category-selected(string);
    callback story-selected(StoryItem);
    callback open-url-requested(string);

    in-out property <length> scroll-y: 0px;

    clip: true;

    if root.home-loading: VerticalBox {
        alignment: center;
        Text {
            text: root.tr-loading;
            horizontal-alignment: center;
        }
    }

    scroller := ScrollView {
        visible: !root.home-loading;
        width: parent.width;
        height: parent.height;
        viewport-width: self.visible-width;
        viewport-y <=> root.scroll-y;

        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 16px;
            padding-bottom: 40px;
            spacing: 0px;
            width: scroller.visible-width;

            for item[i] in root.home-items: VerticalLayout {
                // No top padding for the very first item; otherwise separate sections clearly
                padding-top: i == 0 ? 0px : item.item-type == "app-row" || item.item-type == "app-grid" || item.item-type == "categories" || item.item-type == "carousel" ? 28px : 8px;

                // Carousel section (hero + editorial)
                if item.item-type == "carousel": VerticalLayout {
                    spacing: 12px;

                    if item.hero-items.length > 0: HeroCarousel {
                        width: parent.width;
                        items: item.hero-items;
                        tr-installed: root.tr-installed;
                        story-clicked(idx) => {
                            if idx >= 0 && idx < root.home-stories.length {
                                root.story-selected(root.home-stories[idx]);
                            }
                        }
                        app-clicked(id) => {
                            root.detail-requested(id);
                        }
                    }

                    if item.editorial-items.length > 0: Flickable {
                        width: parent.width;
                        height: 154px;
                        viewport-width: item.editorial-items.length * 232px;
                        viewport-height: 154px;
                        interactive: true;

                        for eitem[j] in item.editorial-items: EditorialCard {
                            x: j * 232px;
                            y: 0px;
                            item: eitem;
                            clicked(id, is-story) => {
                                if is-story {
                                    if eitem.story-index >= 0 && eitem.story-index < root.home-stories.length {
                                        root.story-selected(root.home-stories[eitem.story-index]);
                                    }
                                } else {
                                    root.detail-requested(id);
                                }
                            }
                        }
                    }
                }

                // Text elements
                if item.item-type == "h1": Text {
                    text: item.text;
                    font-size: 22px;
                    font-weight: 700;
                    wrap: word-wrap;
                }

                if item.item-type == "h2": Text {
                    text: item.text;
                    font-size: 17px;
                    font-weight: 700;
                    wrap: word-wrap;
                }

                if item.item-type == "h3": Text {
                    text: item.text;
                    font-size: 14px;
                    font-weight: 600;
                    wrap: word-wrap;
                }

                if item.item-type == "p": Text {
                    text: item.text;
                    font-size: 13px;
                    color: Palette.foreground.transparentize(0.4);
                    wrap: word-wrap;
                }

                if item.item-type == "br" && i > 0: Rectangle {
                    height: 1px;
                    background: Palette.foreground.transparentize(0.88);
                }

                // Horizontal app row
                if item.item-type == "app-row" && item.apps.length > 0: VerticalLayout {
                    spacing: 10px;

                    if item.title != "": VerticalLayout {
                        spacing: 10px;
                        Text {
                            text: item.title;
                            font-size: 17px;
                            font-weight: 700;
                        }

                        Rectangle {
                            height: 1px;
                            background: Palette.foreground.transparentize(0.88);
                        }
                    }

                    Carousel {
                        items: item.apps;
                        tr-installed: root.tr-installed;
                        item-clicked(id) => {
                            root.detail-requested(id);
                        }
                    }
                }

                // App grid
                if item.item-type == "app-grid" && item.apps.length > 0: VerticalLayout {
                    spacing: 10px;

                    if item.title != "": VerticalLayout {
                        spacing: 10px;
                        Text {
                            text: item.title;
                            font-size: 17px;
                            font-weight: 700;
                        }

                        Rectangle {
                            height: 1px;
                            background: Palette.foreground.transparentize(0.88);
                        }
                    }

                    Rectangle {
                        height: ((item.apps.length + 4) / 5) * 164px;
                        preferred-width: 0px;

                        for app[j] in item.apps: PopularCard {
                            x: mod(j, 5) * (parent.width + 12px) / 5;
                            y: ((j - mod(j, 5)) / 5) * 164px;
                            width: (parent.width + 12px) / 5 - 12px;
                            height: 152px;
                            card: app;
                            tr-installed: root.tr-installed;
                            clicked(id) => {
                                root.detail-requested(id);
                            }
                        }
                    }
                }

                // Links section (Mac App Store "More Information" style)
                if item.item-type == "links" && item.link-items.length > 0: VerticalLayout {
                    spacing: 0px;

                    if item.link-title != "": VerticalLayout {
                        spacing: 10px;
                        Text {
                            text: item.link-title;
                            font-size: 17px;
                            font-weight: 700;
                        }

                        Rectangle {
                            height: 1px;
                            background: Palette.foreground.transparentize(0.88);
                        }
                    }

                    for link[j] in item.link-items: VerticalLayout {
                        spacing: 0px;

                        Rectangle {
                            height: 44px;
                            background: link-ta.has-hover ? Palette.alternate-background : transparent;

                            link-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if link.story-index >= 0 {
                                        if link.story-index < root.home-stories.length {
                                            root.story-selected(root.home-stories[link.story-index]);
                                        }
                                    } else if link.app-id != "" {
                                        root.detail-requested(link.app-id);
                                    } else if link.href != "" {
                                        root.open-url-requested(link.href);
                                    }
                                }
                            }

                            HorizontalLayout {
                                padding-left: 2px;
                                padding-right: 2px;
                                alignment: center;

                                Text {
                                    text: link.text;
                                    font-size: 14px;
                                    color: link.href != "" ? Palette.foreground.transparentize(0.15) : Palette.foreground;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }

                                if link.href != "": Text {
                                    text: "↗";
                                    font-size: 11px;
                                    color: Palette.foreground.transparentize(0.4);
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Palette.foreground.transparentize(0.88);
                        }
                    }
                }

                // Categories
                if item.item-type == "categories" && root.categories.length > 0: VerticalLayout {
                    spacing: 10px;

                    VerticalLayout {
                        spacing: 10px;
                        Text {
                            text: root.tr-categories;
                            font-size: 17px;
                            font-weight: 700;
                        }

                        Rectangle {
                            height: 1px;
                            background: Palette.foreground.transparentize(0.88);
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        height: ((root.categories.length + 2) / 3) * 114px - 10px;

                        Rectangle {
                            width: min(parent.width, 750px);
                            height: ((root.categories.length + 2) / 3) * 114px - 10px;

                            for cat[j] in root.categories: CategoryCard {
                                x: mod(j, 3) * (parent.width + 12px) / 3;
                                y: ((j - mod(j, 3)) / 3) * 114px;
                                width: (parent.width + 12px) / 3 - 12px;
                                height: 104px;
                                category: cat;
                                clicked(id) => {
                                    root.category-selected(id);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

import { Theme } from "../theme.slint";
import { AppIcon } from "../components/app-icon.slint";
import { SecurityWarning } from "../components/security-warning.slint";
import { ActionButton } from "../components/action-button.slint";

export component AddFlatpakRepoScreen inherits Rectangle {
    in property <string> repo-title;
    in property <string> repo-url;

    in property <bool> show-security-warning: true;
    in property <string> tr-add-repo: "Add Repository";
    in property <string> tr-unknown-repo: "Unknown repository";
    in property <string> tr-repo-add-desc: "This will add the repository to your Flatpak user installation and make its applications available to install.";
    in property <string> tr-repo-warning: "Adding a third-party repository gives it the ability to distribute software to your system. Only add repositories from sources you trust.";

    callback confirmed();
    callback cancelled();

    VerticalLayout {
        alignment: center;
        padding: 48px;
        spacing: 20px;

        HorizontalLayout {
            alignment: center;
            AppIcon {
                size: 80px;
                icon: @image-url("../../assets/warning.svg");
                icon-size: 40px;
                icon-colorize: Theme.fg.transparentize(0.2);
                outlined: true;
            }
        }

        Text {
            text: root.tr-add-repo;
            font-size: 20px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            text: root.repo-title != "" ? root.repo-title : root.tr-unknown-repo;
            font-size: 14px;
            font-weight: 600;
            horizontal-alignment: center;
        }

        Text {
            text: root.repo-url;
            font-size: 12px;
            color: Theme.fg.transparentize(0.45);
            horizontal-alignment: center;
            overflow: elide;
        }

        Text {
            text: root.tr-repo-add-desc;
            font-size: 13px;
            color: Theme.fg.transparentize(0.25);
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        if root.show-security-warning: HorizontalLayout {
            alignment: center;
            SecurityWarning {
                text: root.tr-repo-warning;
            }
        }

        HorizontalLayout {
            spacing: 12px;
            alignment: center;
            ActionButton {
                width: 280px;
                height: 40px;
                border-radius: 10px;
                text: root.tr-add-repo;
                clicked => {
                    root.confirmed();
                }
            }
        }
    }
}

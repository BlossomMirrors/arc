import { Palette } from "std-widgets.slint";

export component AddFlatpakRepoScreen inherits Rectangle {
    in property <string> repo-title;
    in property <string> repo-url;

    in property <bool> show-security-warning: true;
    in property <string> tr-add-repo: "Add Repository";
    in property <string> tr-unknown-repo: "Unknown repository";
    in property <string> tr-repo-add-desc: "This will add the repository to your Flatpak user installation and make its applications available to install.";
    in property <string> tr-repo-warning: "Adding a third-party repository gives it the ability to distribute software to your system. Only add repositories from sources you trust.";

    callback confirmed();
    callback cancelled();

    VerticalLayout {
        alignment: center;
        padding: 48px;
        spacing: 20px;

        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 80px;
                height: 80px;
                border-radius: 16px;
                background: #80808012;
                border-width: 1px;
                border-color: #80808025;

                Image {
                    source: @image-url("../../assets/warning.svg");
                    width: 40px;
                    height: 40px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    image-fit: contain;
                    colorize: Palette.foreground.transparentize(0.2);
                }
            }
        }

        Text {
            text: root.tr-add-repo;
            font-size: 20px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            text: root.repo-title != "" ? root.repo-title : root.tr-unknown-repo;
            font-size: 14px;
            font-weight: 600;
            horizontal-alignment: center;
        }

        Text {
            text: root.repo-url;
            font-size: 12px;
            color: Palette.foreground.transparentize(0.45);
            horizontal-alignment: center;
            overflow: elide;
        }

        Text {
            text: root.tr-repo-add-desc;
            font-size: 13px;
            color: Palette.foreground.transparentize(0.25);
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        if root.show-security-warning: HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 320px;
                border-radius: 10px;
                background: #f9731610;
                border-width: 1px;
                border-color: #f9731630;

                HorizontalLayout {
                    padding: 12px;
                    spacing: 10px;

                    Image {
                        source: @image-url("../../assets/warning.svg");
                        width: 16px;
                        height: 16px;
                        colorize: #f97316;
                        image-fit: contain;
                        vertical-alignment: top;
                    }

                    Text {
                        text: root.tr-repo-warning;
                        font-size: 11px;
                        color: #f97316;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            alignment: center;

            Rectangle {
                width: 280px;
                height: 40px;
                border-radius: 10px;
                background: confirm-ta.has-hover ? #2563eb : #3b82f6;

                confirm-ta := TouchArea {
                    clicked => {
                        root.confirmed();
                    }
                }

                Text {
                    text: root.tr-add-repo;
                    font-size: 13px;
                    font-weight: 600;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

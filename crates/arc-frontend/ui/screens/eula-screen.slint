import { VerticalBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { AppDetailData } from "../types.slint";
import { AppIcon } from "../components/app-icon.slint";
import { ActionButton, ActionButtonKind } from "../components/action-button.slint";

export component EulaScreen inherits Rectangle {
    in property <AppDetailData> detail-app;

    in property <string> tr-license: "License Agreement";
    in property <string> tr-eula-requires: " requires you to accept its End User License Agreement before installing.";
    in property <string> tr-read-license: "Read License Agreement →";
    in property <string> tr-cancel: "Cancel";
    in property <string> tr-accept-install: "Accept & Install";

    callback confirmed();
    callback cancelled();
    callback open-url-requested(string);

    VerticalBox {
        alignment: center;
        padding: 48px;
        spacing: 20px;

        HorizontalLayout {
            alignment: center;
            AppIcon {
                size: 80px;
                icon: root.detail-app.icon;
                icon-size: 64px;
                outlined: true;
            }
        }

        Text {
            text: root.tr-license;
            font-size: 20px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            text: root.detail-app.name + root.tr-eula-requires;
            font-size: 13px;
            color: Theme.fg.transparentize(0.25);
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        if root.detail-app.eula-url != "": HorizontalLayout {
            alignment: center;

            Rectangle {
                height: 32px;
                width: eula-label.preferred-width + 24px;
                border-radius: 8px;
                background: eula-ta.has-hover ? Theme.surface-border : Theme.surface;
                border-width: 1px;
                border-color: Theme.control-hover;

                eula-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.open-url-requested(root.detail-app.eula-url);
                    }
                }

                eula-label := Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.tr-read-license;
                    font-size: 12px;
                    color: Theme.accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            alignment: center;

            ActionButton {
                kind: ActionButtonKind.secondary;
                text: root.tr-cancel;
                clicked => {
                    root.cancelled();
                }
            }

            ActionButton {
                text: root.tr-accept-install;
                clicked => {
                    root.confirmed();
                }
            }
        }
    }
}

import { Theme } from "../theme.slint";
import { AppIcon } from "../components/app-icon.slint";
import { SecurityWarning } from "../components/security-warning.slint";
import { ActionButton, ActionButtonKind } from "../components/action-button.slint";

export component InstallFileScreen inherits Rectangle {
    in property <string> install-file-name;
    in property <bool> install-file-has-flatpak;
    in property <string> install-file-flatpak-name;
    in property <bool> install-file-is-appimage;
    in property <bool> install-file-flatpak-searched;
    in property <bool> install-file-is-flatpak-bundle;
    in property <image> icon-package;
    in property <bool> show-security-warning: true;

    in property <string> tr-install-flatpak-bundle: "Install Flatpak Bundle";
    in property <string> tr-install-flatpak-bundle-desc: "This will install the bundled Flatpak application on your system.";
    in property <string> tr-install-appimage: "Install AppImage";
    in property <string> tr-install-appimage-desc: "This will register the AppImage so it appears in your app launcher.";
    in property <string> tr-install-package: "Install Package";
    in property <string> tr-install-package-desc: "Choose how you'd like to install this package file.";
    in property <string> tr-install-bundle: "Install Bundle";
    in property <string> tr-install-as-appimage: "Install as AppImage";
    in property <string> tr-install-distrobox: "Install via Distrobox";
    in property <string> tr-install-from-prefix: "Install ";
    in property <string> tr-install-from-suffix: " from Arc Store instead";
    in property <string> tr-searching-flathub: "Searching Flathub for an alternative...";
    in property <string> tr-file-security: "Third-party software has broad access to system resources and may pose a security risk. Only install files from sources you trust.";

    callback distrobox-requested();
    callback appimage-requested();
    callback flatpak-requested();
    callback bundle-requested();
    callback cancelled();

    private property <string> screen-title:
        root.install-file-is-flatpak-bundle ? root.tr-install-flatpak-bundle : root.install-file-is-appimage ? root.tr-install-appimage : root.tr-install-package;

    private property <string> screen-description:
        root.install-file-is-flatpak-bundle ? root.tr-install-flatpak-bundle-desc : root.install-file-is-appimage ? root.tr-install-appimage-desc : root.tr-install-package-desc;

    VerticalLayout {
        alignment: center;
        padding: 48px;
        spacing: 20px;

        HorizontalLayout {
            alignment: center;
            AppIcon {
                size: 80px;
                icon: root.icon-package;
                icon-size: 44px;
                icon-colorize: Theme.fg.transparentize(0.15);
                outlined: true;
            }
        }

        Text {
            text: root.screen-title;
            font-size: 20px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            text: root.install-file-name;
            font-size: 12px;
            color: Theme.fg.transparentize(0.45);
            horizontal-alignment: center;
            overflow: elide;
        }

        Text {
            text: root.screen-description;
            font-size: 13px;
            color: Theme.fg.transparentize(0.25);
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        VerticalLayout {
            spacing: 10px;

            if root.install-file-is-flatpak-bundle: HorizontalLayout {
                alignment: center;
                ActionButton {
                    width: 280px;
                    height: 40px;
                    border-radius: 10px;
                    text: root.tr-install-bundle;
                    clicked => {
                        root.bundle-requested();
                    }
                }
            }

            if root.install-file-is-appimage && !root.install-file-is-flatpak-bundle: HorizontalLayout {
                alignment: center;
                ActionButton {
                    width: 280px;
                    height: 40px;
                    border-radius: 10px;
                    text: root.tr-install-as-appimage;
                    clicked => {
                        root.appimage-requested();
                    }
                }
            }

            if !root.install-file-is-appimage && !root.install-file-is-flatpak-bundle: HorizontalLayout {
                alignment: center;
                ActionButton {
                    width: 280px;
                    height: 40px;
                    border-radius: 10px;
                    text: root.tr-install-distrobox;
                    clicked => {
                        root.distrobox-requested();
                    }
                }
            }

            // Flathub alternative (elided dynamic name, kept bespoke)
            if root.install-file-has-flatpak && !root.install-file-is-flatpak-bundle: HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 280px;
                    height: 40px;
                    border-radius: 10px;
                    background: btn-flatpak-ta.has-hover ? Theme.control-hover : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.control-border;

                    btn-flatpak-ta := TouchArea {
                        clicked => {
                            root.flatpak-requested();
                        }
                    }

                    Text {
                        text: root.tr-install-from-prefix + root.install-file-flatpak-name + root.tr-install-from-suffix;
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.fg.transparentize(0.1);
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                        width: parent.width - 16px;
                        x: 8px;
                    }
                }
            }

            if !root.install-file-is-appimage && !root.install-file-is-flatpak-bundle && !root.install-file-has-flatpak && !root.install-file-flatpak-searched: HorizontalLayout {
                alignment: center;
                Text {
                    text: root.tr-searching-flathub;
                    font-size: 12px;
                    color: Theme.fg.transparentize(0.5);
                    horizontal-alignment: center;
                }
            }
        }

        if root.show-security-warning: HorizontalLayout {
            alignment: center;
            SecurityWarning {
                text: root.tr-file-security;
            }
        }
    }
}

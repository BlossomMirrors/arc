import { VerticalBox, Palette } from "std-widgets.slint";

import { TopBar } from "components/top-bar.slint";

import { HomeScreen } from "screens/home-screen.slint";
import { PackageListScreen } from "screens/package-list-screen.slint";
import { DetailScreen } from "screens/detail-screen.slint";
import { InstallFileScreen } from "screens/install-file-screen.slint";
import {
    InstallFlatpakrefScreen,
} from "screens/install-flatpakref-screen.slint";
import { EulaScreen } from "screens/eula-screen.slint";
import { AddFlatpakRepoScreen } from "screens/add-flatpakrepo-screen.slint";
import { SettingsScreen } from "screens/settings-screen.slint";
import { DownloadManagerScreen } from "screens/download-manager-screen.slint";
import { StoryScreen } from "screens/story-screen.slint";

import {
    PackageItem,
    AppDetailData,
    AppCardData,
    CategoryItem,
    HomeItem,
    HeroItem,
    LinkItem,
    TransactionItem,
    RemoteItem,
    ExtensionItem,
    DescriptionBlock,
    StoryItem,
} from "types.slint";
export {
    PackageItem,
    AppDetailData,
    AppCardData,
    CategoryItem,
    HomeItem,
    HeroItem,
    LinkItem,
    TransactionItem,
    RemoteItem,
    ExtensionItem,
    DescriptionBlock,
    StoryItem,
} from "types.slint";

export component AppWindow inherits Window {
    title: "Arc Store";
    icon: @image-url("../assets/arc.svg");
    min-width: 900px;
    min-height: 640px;

    in-out property <string> search-text: "";
    in-out property <[PackageItem]> packages: [];
    in-out property <bool> is-loading: false;
    in-out property <string> current-view: "home";

    in-out property <[HomeItem]> home-items: [];
    in-out property <[CategoryItem]> categories: [];
    in-out property <[StoryItem]> home-stories: [];
    in-out property <StoryItem> current-story;
    in-out property <bool> home-loading: false;

    in-out property <string> prev-view: "home";
    in-out property <string> eula-source-view: "";
    in-out property <AppDetailData> detail-app;
    in-out property <bool> detail-loading: false;
    in-out property <bool> detail-screenshots-loading: false;
    in-out property <string> settings-preferred: "Flatpak";
    in-out property <bool> settings-ignore-native-pref: false;
    in-out property <bool> settings-auto-updates: true;
    in-out property <int> settings-concurrent-downloads: 3;
    in-out property <bool> settings-show-security-warnings: true;
    in-out property <[RemoteItem]> settings-remotes: [];
    in-out property <bool> settings-remotes-loading: false;

    in-out property <string> add-repo-title: "";
    in-out property <string> add-repo-url: "";

    in-out property <bool> install-file-is-flatpak-bundle: false;

    in-out property <[image]> detail-screenshots: [];
    in-out property <[ExtensionItem]> detail-extensions: [];
    in-out property <[DescriptionBlock]> detail-description-blocks: [];
    in-out property <bool> detail-busy: false;
    in-out property <float> detail-progress: 0;
    in-out property <string> detail-transaction-id: "";
    in-out property <int> update-count: 0;

    // Translations
    in-out property <string> tr-install: "Install";
    in-out property <string> tr-remove: "Remove";
    in-out property <string> tr-update: "Update";
    in-out property <string> tr-cancel: "Cancel";
    in-out property <string> tr-loading: "Loading...";
    in-out property <string> tr-installed: "Installed";
    in-out property <string> tr-back: "Back";
    in-out property <string> tr-run: "Run";
    in-out property <string> tr-working: "Working...";
    in-out property <string> tr-verified: "Verified developer";
    in-out property <string> tr-website: "Website";
    in-out property <string> tr-extensions: "Extensions";
    in-out property <string> tr-restart: "Restart";
    in-out property <string> tr-name: "Name";
    in-out property <string> tr-url: "URL";
    in-out property <string> tr-categories: "Categories";
    in-out property <string> tr-recommended-apps: "Recommended Apps";
    in-out property <string> tr-no-packages: "No packages found.\nSearch for an application to get started.";
    in-out property <string> tr-up-to-date: "Everything is up to date.";
    in-out property <string> tr-no-installed: "No applications installed.";
    in-out property <string> tr-downloads: "Downloads & Updates";
    in-out property <string> tr-checking: "Checking...";
    in-out property <string> tr-check-updates: "Check for Updates";
    in-out property <string> tr-active-prefix: "Active (";
    in-out property <string> tr-pending-prefix: "Pending (";
    in-out property <string> tr-completed-prefix: "Completed (";
    in-out property <string> tr-clear-all: "Clear All";
    in-out property <string> tr-updates-available-prefix: "Updates Available (";
    in-out property <string> tr-update-all: "Update All";
    in-out property <string> tr-no-downloads: "No active downloads";
    in-out property <string> tr-downloads-empty: "Installs and updates will appear here";
    in-out property <string> tr-removed: "Removed";
    in-out property <string> tr-failed: "Failed";
    in-out property <string> tr-queued: "Queued";
    in-out property <string> tr-removing: "Removing";
    in-out property <string> tr-updating: "Updating";
    in-out property <string> tr-installing: "Installing";
    in-out property <string> tr-license: "License Agreement";
    in-out property <string> tr-eula-requires: " requires you to accept its End User License Agreement before installing.";
    in-out property <string> tr-read-license: "Read License Agreement →";
    in-out property <string> tr-accept-install: "Accept & Install";
    in-out property <string> tr-install-flatpak-bundle: "Install Flatpak Bundle";
    in-out property <string> tr-install-flatpak-bundle-desc: "This will install the bundled Flatpak application on your system.";
    in-out property <string> tr-install-appimage: "Install AppImage";
    in-out property <string> tr-install-appimage-desc: "This will register the AppImage so it appears in your app launcher.";
    in-out property <string> tr-install-package: "Install Package";
    in-out property <string> tr-install-package-desc: "Choose how you'd like to install this package file.";
    in-out property <string> tr-install-bundle: "Install Bundle";
    in-out property <string> tr-install-as-appimage: "Install as AppImage";
    in-out property <string> tr-install-distrobox: "Install via Distrobox";
    in-out property <string> tr-install-from-prefix: "Install ";
    in-out property <string> tr-install-from-suffix: " from Arc Store instead";
    in-out property <string> tr-searching-flathub: "Searching Flathub for an alternative...";
    in-out property <string> tr-file-security: "Third-party software has broad access to system resources and may pose a security risk. Only install files from sources you trust.";
    in-out property <string> tr-add-repo: "Add Repository";
    in-out property <string> tr-unknown-repo: "Unknown repository";
    in-out property <string> tr-repo-add-desc: "This will add the repository to your Flatpak user installation and make its applications available to install.";
    in-out property <string> tr-repo-warning: "Adding a third-party repository gives it the ability to distribute software to your system. Only add repositories from sources you trust.";
    in-out property <string> tr-contains-repo: "Contains repository";
    in-out property <string> tr-install-application: "Install Application";
    in-out property <string> tr-settings: "Settings";
    in-out property <string> tr-general: "GENERAL";
    in-out property <string> tr-auto-updates: "Auto-updates";
    in-out property <string> tr-auto-updates-desc: "Automatically update installed apps in the background";
    in-out property <string> tr-security-warnings: "Security warnings";
    in-out property <string> tr-security-warnings-desc: "Show warnings when installing third-party software or adding repositories";
    in-out property <string> tr-downloads-section: "DOWNLOADS";
    in-out property <string> tr-concurrent: "Concurrent downloads";
    in-out property <string> tr-concurrent-desc: "Maximum number of simultaneous downloads (1-16)";
    in-out property <string> tr-repositories: "REPOSITORIES";
    in-out property <string> tr-loading-ellipsis: "Loading…";
    in-out property <string> tr-protected: "Protected";
    in-out property <string> tr-add-repo-section: "ADD REPOSITORY";
    in-out property <string> tr-danger-zone: "DANGER ZONE";
    in-out property <string> tr-force-updates: "Force updates";
    in-out property <string> tr-force-updates-desc: "Runs flatpak update -y directly, bypassing the daemon";
    in-out property <string> tr-force-update: "Force Update";
    in-out property <string> tr-restart-daemon: "Restart daemon";
    in-out property <string> tr-restart-daemon-desc: "Kills the running arc-daemon and starts a fresh one in the background";
    in-out property <string> tr-search-placeholder: "Search for applications...";
    in-out property <string> tr-proprietary: "Proprietary";
    in-out property <string> tr-all-ages: "All ages";
    in-out property <string> tr-pwa: "PWA";
    in-out property <string> tr-uninstall: "Uninstall";
    in-out property <string> tr-uninstall-title-prefix: "Uninstall ";
    in-out property <string> tr-uninstall-title-suffix: "";
    in-out property <string> tr-delete-data: "Also delete app data";
    in-out property <string> tr-delete-data-desc: "Removes settings and saved data";

    // Remove confirmation dialog state
    in-out property <bool> show-remove-dialog: false;
    in-out property <string> remove-dialog-pkg-id: "";
    in-out property <string> remove-dialog-name: "";
    in-out property <image> remove-dialog-icon;
    in-out property <bool> remove-dialog-delete-data: true;

    in-out property <[TransactionItem]> active-transactions: [];
    in-out property <[TransactionItem]> pending-transactions: [];
    in-out property <[TransactionItem]> completed-transactions: [];
    in-out property <[PackageItem]> available-updates: [];
    in-out property <int> active-transaction-count: 0;
    in-out property <bool> updates-loading: false;
    in-out property <bool> updates-all-queued: false;

    in-out property <string> install-file-path: "";
    in-out property <string> install-file-name: "";
    in-out property <string> install-file-flatpak-id: "";
    in-out property <string> install-file-flatpak-name: "";
    in-out property <bool> install-file-has-flatpak: false;
    in-out property <bool> install-file-flatpak-searched: false;
    in-out property <bool> install-file-is-appimage: false;

    in-out property <string> install-flatpakref-name: "";
    in-out property <string> install-flatpakref-app-id: "";
    in-out property <string> install-flatpakref-repo-url: "";

    in-out property <image> icon-home;
    in-out property <image> icon-search;
    in-out property <image> icon-settings;
    in-out property <image> icon-trash;
    in-out property <image> icon-package;
    in-out property <image> icon-nav-back;
    in-out property <image> icon-nav-forward;

    in property <bool> can-go-back: false;
    in property <bool> can-go-forward: false;

    callback nav-back();
    callback nav-forward();
    callback nav-story(StoryItem);
    callback nav-settings();
    callback nav-installed();
    callback nav-downloads();

    callback detail-requested(string);
    callback search-requested(string);
    callback install-requested(string);
    callback remove-requested(string);
    callback update-requested(string);
    callback refresh-requested();
    callback refresh-updates-requested();
    callback category-selected(string);
    callback app-selected(string);
    callback save-settings(string, bool, bool, int, bool);
    callback load-remotes();
    callback add-remote(string, string);
    callback remove-remote(string);
    callback add-repo-confirmed();
    callback add-repo-cancelled();
    callback install-file-bundle-requested();
    callback install-file-distrobox-requested();
    callback install-file-appimage-requested();
    callback install-file-flatpak-requested();
    callback install-file-cancelled();
    callback install-flatpakref-confirmed();
    callback install-flatpakref-cancelled();
    callback eula-confirmed();
    callback eula-cancelled();
    callback force-update-requested();
    callback restart-daemon-requested();
    callback open-url-requested(string);
    callback remove-confirmed(string, bool);
    callback launch-requested(string);
    callback install-extension-requested(string);
    callback remove-extension-requested(string);
    callback refresh-extensions-requested();
    callback clear-completed-requested();
    callback update-all-requested();
    callback cancel-requested(string);
    callback home-clicked();
    callback back-to-home();

    VerticalBox {
        padding: 0px;
        spacing: 0px;

        top-bar := TopBar {
            search-text <=> root.search-text;
            update-count: root.update-count + root.active-transaction-count;
            current-view: root.current-view;
            icon-home: root.icon-home;
            icon-search: root.icon-search;
            icon-settings: root.icon-settings;
            icon-nav-back: root.icon-nav-back;
            icon-nav-forward: root.icon-nav-forward;
            can-go-back: root.can-go-back;
            can-go-forward: root.can-go-forward;
            tr-search-placeholder: root.tr-search-placeholder;
            tr-installed: root.tr-installed;
            tr-downloads: root.tr-downloads;
            search-requested(text) => {
                root.search-requested(text);
            }
            installed-clicked => {
                root.nav-installed();
            }
            downloads-clicked => {
                root.nav-downloads();
            }
            home-clicked => {
                root.home-clicked();
            }
            settings-clicked => {
                root.nav-settings();
            }
            nav-back => {
                root.nav-back();
            }
            nav-forward => {
                root.nav-forward();
            }
        }

        Rectangle {
            vertical-stretch: 1;
            clip: true;

            // Defocus the search bar when the user clicks anywhere in the content area.
            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => {
                    top-bar.clear-search-focus();
                }
            }

            HomeScreen {
                visible: root.current-view == "home";
                width: parent.width;
                height: parent.height;
                home-items: root.home-items;
                categories: root.categories;
                home-stories: root.home-stories;
                home-loading: root.home-loading;
                tr-loading: root.tr-loading;
                tr-installed: root.tr-installed;
                tr-categories: root.tr-categories;
                tr-recommended-apps: root.tr-recommended-apps;
                detail-requested(id) => {
                    root.detail-requested(id);
                }
                category-selected(id) => {
                    root.category-selected(id);
                }
                story-selected(story) => {
                    root.nav-story(story);
                }
                open-url-requested(url) => {
                    root.open-url-requested(url);
                }
            }

            if root.current-view == "story": StoryScreen {
                width: parent.width;
                height: parent.height;
                story: root.current-story;
                tr-installed: root.tr-installed;
                app-clicked(id) => {
                    root.detail-requested(id);
                }
            }

            PackageListScreen {
                visible: root.current-view == "search" || root.current-view == "installed";
                width: parent.width;
                height: parent.height;
                packages: root.packages;
                is-loading: root.is-loading;
                current-view: root.current-view;
                icon-trash: root.icon-trash;
                tr-loading: root.tr-loading;
                tr-no-packages: root.tr-no-packages;
                tr-up-to-date: root.tr-up-to-date;
                tr-no-installed: root.tr-no-installed;
                tr-install: root.tr-install;
                tr-update: root.tr-update;
                tr-cancel: root.tr-cancel;
                tr-installing: root.tr-installing;
                detail-requested(id) => {
                    root.detail-requested(id);
                }
                install-requested(id) => {
                    root.install-requested(id);
                }
                remove-requested(id) => {
                    root.remove-requested(id);
                }
                update-requested(id) => {
                    root.update-requested(id);
                }
                cancel-requested(id) => {
                    root.cancel-requested(id);
                }
            }

            if root.current-view == "detail": DetailScreen {
                width: parent.width;
                height: parent.height;
                detail-app: root.detail-app;
                detail-loading: root.detail-loading || root.detail-screenshots-loading;
                detail-busy: root.detail-busy;
                detail-progress: root.detail-progress;
                detail-transaction-id: root.detail-transaction-id;
                detail-screenshots: root.detail-screenshots;
                detail-extensions: root.detail-extensions;
                detail-description-blocks: root.detail-description-blocks;
                settings-preferred: root.settings-preferred;
                icon-trash: root.icon-trash;
                tr-loading: root.tr-loading;
                tr-website: root.tr-website;
                tr-extensions: root.tr-extensions;
                tr-install: root.tr-install;
                tr-remove: root.tr-remove;
                tr-run: root.tr-run;
                tr-cancel: root.tr-cancel;
                tr-working: root.tr-working;
                tr-verified: root.tr-verified;
                tr-proprietary: root.tr-proprietary;
                tr-all-ages: root.tr-all-ages;
                tr-pwa: root.tr-pwa;
                install-requested(id) => {
                    root.install-requested(id);
                }
                remove-requested(id) => {
                    root.remove-requested(id);
                }
                cancel-requested(id) => {
                    root.cancel-requested(id);
                }
                launch-requested(id) => {
                    root.launch-requested(id);
                }
                open-url-requested(url) => {
                    root.open-url-requested(url);
                }
                install-extension-requested(id) => {
                    root.install-extension-requested(id);
                }
                remove-extension-requested(id) => {
                    root.remove-extension-requested(id);
                }
                eula-requested => {
                    root.eula-source-view = root.current-view;
                    root.current-view = "eula";
                }
            }

            if root.current-view == "downloads": DownloadManagerScreen {
                width: parent.width;
                height: parent.height;
                active-transactions: root.active-transactions;
                pending-transactions: root.pending-transactions;
                completed-transactions: root.completed-transactions;
                available-updates: root.available-updates;
                updates-loading: root.updates-loading;
                updates-all-queued: root.updates-all-queued;
                tr-downloads: root.tr-downloads;
                tr-checking: root.tr-checking;
                tr-check-updates: root.tr-check-updates;
                tr-active-prefix: root.tr-active-prefix;
                tr-pending-prefix: root.tr-pending-prefix;
                tr-completed-prefix: root.tr-completed-prefix;
                tr-clear-all: root.tr-clear-all;
                tr-updates-available-prefix: root.tr-updates-available-prefix;
                tr-update-all: root.tr-update-all;
                tr-no-downloads: root.tr-no-downloads;
                tr-downloads-empty: root.tr-downloads-empty;
                tr-update: root.tr-update;
                tr-cancel: root.tr-cancel;
                tr-removed: root.tr-removed;
                tr-installed: root.tr-installed;
                tr-failed: root.tr-failed;
                tr-queued: root.tr-queued;
                tr-removing: root.tr-removing;
                tr-updating: root.tr-updating;
                tr-installing: root.tr-installing;
                clear-completed-requested => {
                    root.clear-completed-requested();
                }
                update-all-requested => {
                    root.update-all-requested();
                }
                update-requested(id) => {
                    root.update-requested(id);
                }
                refresh-updates-requested => {
                    root.refresh-updates-requested();
                }
                cancel-requested(id) => {
                    root.cancel-requested(id);
                }
                detail-requested(id) => {
                    root.prev-view = "downloads";
                    root.detail-requested(id);
                }
            }

            if root.current-view == "install-file": InstallFileScreen {
                width: parent.width;
                height: parent.height;
                icon-package: root.icon-package;
                show-security-warning: root.settings-show-security-warnings;
                install-file-name: root.install-file-name;
                install-file-has-flatpak: root.install-file-has-flatpak;
                install-file-flatpak-searched: root.install-file-flatpak-searched;
                install-file-flatpak-name: root.install-file-flatpak-name;
                install-file-is-appimage: root.install-file-is-appimage;
                install-file-is-flatpak-bundle: root.install-file-is-flatpak-bundle;
                tr-install-flatpak-bundle: root.tr-install-flatpak-bundle;
                tr-install-flatpak-bundle-desc: root.tr-install-flatpak-bundle-desc;
                tr-install-appimage: root.tr-install-appimage;
                tr-install-appimage-desc: root.tr-install-appimage-desc;
                tr-install-package: root.tr-install-package;
                tr-install-package-desc: root.tr-install-package-desc;
                tr-install-bundle: root.tr-install-bundle;
                tr-install-as-appimage: root.tr-install-as-appimage;
                tr-install-distrobox: root.tr-install-distrobox;
                tr-install-from-prefix: root.tr-install-from-prefix;
                tr-install-from-suffix: root.tr-install-from-suffix;
                tr-searching-flathub: root.tr-searching-flathub;
                tr-file-security: root.tr-file-security;
                distrobox-requested => {
                    root.install-file-distrobox-requested();
                }
                appimage-requested => {
                    root.install-file-appimage-requested();
                }
                flatpak-requested => {
                    root.install-file-flatpak-requested();
                }
                bundle-requested => {
                    root.install-file-bundle-requested();
                }
                cancelled => {
                    root.install-file-cancelled();
                }
            }

            if root.current-view == "add-repo": AddFlatpakRepoScreen {
                width: parent.width;
                height: parent.height;
                show-security-warning: root.settings-show-security-warnings;
                repo-title: root.add-repo-title;
                repo-url: root.add-repo-url;
                tr-add-repo: root.tr-add-repo;
                tr-unknown-repo: root.tr-unknown-repo;
                tr-repo-add-desc: root.tr-repo-add-desc;
                tr-repo-warning: root.tr-repo-warning;
                confirmed => {
                    root.add-repo-confirmed();
                }
                cancelled => {
                    root.add-repo-cancelled();
                }
            }

            if root.current-view == "install-flatpakref": InstallFlatpakrefScreen {
                width: parent.width;
                height: parent.height;
                icon-package: root.icon-package;
                show-security-warning: root.settings-show-security-warnings;
                app-name: root.install-flatpakref-name;
                app-id: root.install-flatpakref-app-id;
                repo-url: root.install-flatpakref-repo-url;
                tr-install-application: root.tr-install-application;
                tr-install: root.tr-install;
                tr-repo-warning: root.tr-repo-warning;
                confirmed => {
                    root.install-flatpakref-confirmed();
                }
                cancelled => {
                    root.install-flatpakref-cancelled();
                }
            }

            if root.current-view == "eula": EulaScreen {
                width: parent.width;
                height: parent.height;
                detail-app: root.detail-app;
                tr-license: root.tr-license;
                tr-eula-requires: root.tr-eula-requires;
                tr-read-license: root.tr-read-license;
                tr-cancel: root.tr-cancel;
                tr-accept-install: root.tr-accept-install;
                confirmed => {
                    root.eula-confirmed();
                }
                cancelled => {
                    root.eula-cancelled();
                }
                open-url-requested(url) => {
                    root.open-url-requested(url);
                }
            }

            if root.current-view == "settings": SettingsScreen {
                width: parent.width;
                height: parent.height;
                settings-preferred <=> root.settings-preferred;
                tr-settings: root.tr-settings;
                tr-general: root.tr-general;
                tr-auto-updates: root.tr-auto-updates;
                tr-auto-updates-desc: root.tr-auto-updates-desc;
                tr-security-warnings: root.tr-security-warnings;
                tr-security-warnings-desc: root.tr-security-warnings-desc;
                tr-downloads-section: root.tr-downloads-section;
                tr-concurrent: root.tr-concurrent;
                tr-concurrent-desc: root.tr-concurrent-desc;
                tr-repositories: root.tr-repositories;
                tr-loading-ellipsis: root.tr-loading-ellipsis;
                tr-protected: root.tr-protected;
                tr-remove: root.tr-remove;
                tr-add-repo-section: root.tr-add-repo-section;
                tr-name: root.tr-name;
                tr-url: root.tr-url;
                tr-add-repo: root.tr-add-repo;
                tr-danger-zone: root.tr-danger-zone;
                tr-force-updates: root.tr-force-updates;
                tr-force-updates-desc: root.tr-force-updates-desc;
                tr-force-update: root.tr-force-update;
                tr-restart-daemon: root.tr-restart-daemon;
                tr-restart-daemon-desc: root.tr-restart-daemon-desc;
                tr-restart: root.tr-restart;
                settings-ignore-native-pref <=> root.settings-ignore-native-pref;
                settings-auto-updates <=> root.settings-auto-updates;
                settings-concurrent-downloads <=> root.settings-concurrent-downloads;
                settings-show-security-warnings <=> root.settings-show-security-warnings;
                settings-remotes <=> root.settings-remotes;
                settings-remotes-loading <=> root.settings-remotes-loading;
                back-clicked => {
                    root.current-view = root.prev-view;
                }
                save-settings(preferred, ignore, auto_upd, concur, warnings) => {
                    root.save-settings(preferred, ignore, auto_upd, concur, warnings);
                }
                load-remotes => {
                    root.load-remotes();
                }
                add-remote(name, url) => {
                    root.add-remote(name, url);
                }
                remove-remote(name) => {
                    root.remove-remote(name);
                }
                force-update-requested => {
                    root.force-update-requested();
                }
                restart-daemon-requested => {
                    root.restart-daemon-requested();
                }
            }
            if root.show-remove-dialog: Rectangle {
                width: parent.width;
                height: parent.height;
                background: #00000060;

                TouchArea {
                    clicked => {
                        root.show-remove-dialog = false;
                    }
                }

                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: min(380px, parent.width - 48px);
                    height: dialog-layout.preferred-height + 48px;
                    border-radius: 12px;
                    background: Palette.background;
                    drop-shadow-blur: 32px;
                    drop-shadow-color: #00000060;

                    TouchArea { }

                    dialog-layout := VerticalLayout {
                        padding: 24px;
                        spacing: 16px;

                        // Icon + title
                        HorizontalLayout {
                            spacing: 14px;
                            alignment: start;

                            Rectangle {
                                width: 48px;
                                height: 48px;
                                border-radius: 10px;
                                background: #80808012;
                                border-width: 1px;
                                border-color: #80808025;

                                Image {
                                    source: root.remove-dialog-icon;
                                    width: 40px;
                                    height: 40px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    image-fit: contain;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: root.tr-uninstall-title-prefix + root.remove-dialog-name + root.tr-uninstall-title-suffix + "?";
                                    font-size: 15px;
                                    font-weight: 700;
                                    overflow: elide;
                                }

                                Text {
                                    text: root.remove-dialog-pkg-id;
                                    font-size: 11px;
                                    color: Palette.foreground.transparentize(0.5);
                                    overflow: elide;
                                }
                            }
                        }

                        // Delete data checkbox row
                        Rectangle {
                            height: 48px;
                            border-radius: 8px;
                            background: delete-data-ta.has-hover ? #80808010 : #80808008;
                            border-width: 1px;
                            border-color: #80808020;

                            delete-data-ta := TouchArea {
                                clicked => {
                                    root.remove-dialog-delete-data = !root.remove-dialog-delete-data;
                                }
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                spacing: 12px;
                                alignment: start;

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;

                                    Rectangle {
                                        width: 18px;
                                        height: 18px;
                                        border-radius: 4px;
                                        border-width: 1.5px;
                                        border-color: root.remove-dialog-delete-data ? #ef4444 : #80808050;
                                        background: root.remove-dialog-delete-data ? #ef4444 : transparent;

                                        Text {
                                            text: "✓";
                                            color: white;
                                            font-size: 11px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            opacity: root.remove-dialog-delete-data ? 1 : 0;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 1px;

                                    Text {
                                        text: root.tr-delete-data;
                                        font-size: 13px;
                                        font-weight: 500;
                                        color: Palette.foreground.transparentize(0.1);
                                    }

                                    Text {
                                        text: root.tr-delete-data-desc;
                                        font-size: 11px;
                                        color: Palette.foreground.transparentize(0.45);
                                    }
                                }
                            }
                        }

                        // Buttons
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;

                            Rectangle {
                                width: dlg-cancel-lbl.preferred-width + 28px;
                                height: 36px;
                                border-radius: 8px;
                                background: dlg-cancel-ta.has-hover ? #80808020 : transparent;
                                border-width: 1px;
                                border-color: #80808030;

                                dlg-cancel-ta := TouchArea {
                                    clicked => {
                                        root.show-remove-dialog = false;
                                    }
                                }

                                dlg-cancel-lbl := Text {
                                    text: root.tr-cancel;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Palette.foreground.transparentize(0.2);
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                width: dlg-remove-lbl.preferred-width + 28px;
                                height: 36px;
                                border-radius: 8px;
                                background: dlg-remove-ta.has-hover ? #dc2626 : #ef4444;

                                dlg-remove-ta := TouchArea {
                                    clicked => {
                                        root.show-remove-dialog = false;
                                        root.remove-confirmed(root.remove-dialog-pkg-id, root.remove-dialog-delete-data);
                                    }
                                }

                                dlg-remove-lbl := Text {
                                    text: root.tr-uninstall;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: white;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export struct PackageItem {
    id: string,
    name: string,
    version: string,
    description: string,
    installed: bool,
    icon: image,
    busy: bool,
    progress: float,
    transaction-id: string,
}

export struct DescriptionBlock {
    text: string,
    is-list-item: bool,
    is-heading: bool,
    is-bold: bool,
    is-image: bool,
    image: image,
}

export struct AppDetailData {
    id: string,
    name: string,
    developer: string,
    summary: string,
    version: string,
    icon: image,
    installed: bool,
    flatpak-id: string,
    native-id: string,
    lutris-id: string,
    appimage-id: string,
    flatpak-installed: bool,
    native-installed: bool,
    lutris-installed: bool,
    appimage-installed: bool,
    verified: bool,
    pwa: bool,
    license: string,
    eula-url: string,
    homepage-url: string,
    content-rating: string,
}

export struct AppCardData {
    id: string,
    name: string,
    summary: string,
    icon: image,
    installed: bool,
}

export struct CategoryItem {
    id: string,
    label: string,
    icon: image,
    bg-color: color,
}

export struct ExtensionItem {
    id: string,
    name: string,
    installed: bool,
}

export struct HeroItem {
    id: string,
    banner: image,       // story banner (may be empty for apps)
    icon: image,         // app icon (may be empty for stories)
    title: string,
    body: string,
    is-story: bool,
    story-index: int,    // index into home-stories (-1 for apps)
}

export struct LinkItem {
    text: string,
    href: string,        // external URL (empty for story/app)
    story-index: int,    // -1 if not a story, else index into home-stories
    app-id: string,      // flatpak ID (empty for non-app items)
}

export struct HomeItem {
    item-type: string,   // "h1"|"h2"|"h3"|"p"|"br"|"app-row"|"app-grid"|"categories"|"carousel"|"links"
    text: string,        // text sections
    title: string,       // optional heading for app sections
    apps: [AppCardData],
    hero-items: [HeroItem],
    editorial-items: [HeroItem],
    link-title: string,
    link-items: [LinkItem],
}

export struct RemoteItem {
    name: string,
    url: string,
    protected: bool,
}

export struct StoryItem {
    id: string,
    title: string,
    screenshot: image,
    description-blocks: [DescriptionBlock],
    featured-apps: [AppCardData],
}

export struct TransactionItem {
    id: string,
    pkg-id: string,
    parent-id: string,
    name: string,
    icon: image,
    progress: float,
    status: string,   // "pending" | "running" | "completed" | "failed"
    tx-type: string,  // "install" | "remove" | "update" | "flatpakref"
    error: string,
}
